---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE, getDictionary, type Locale, type NavKey } from '../lib/site';
import '../styles/global.css';

interface Props {
  locale: Locale;
  currentNav: NavKey;
  pagePath: string;
  paths: Record<Locale, string>;
  title?: string;
  description?: string;
  ogImage?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  locale,
  currentNav,
  pagePath,
  paths,
  title = `${getDictionary(locale).branding.title} | ${getDictionary(locale).branding.subtitle}`,
  description = getDictionary(locale).home.heroDescription,
  ogImage = SITE.defaultOgImage,
  showHeader = true,
  showFooter = true
} = Astro.props as Props;
const copy = getDictionary(locale);

const canonical = new URL(pagePath, SITE.origin).toString();
const ogImageUrl = new URL(ogImage, SITE.origin).toString();
const railPrimary = locale === 'zh' ? '个人档案' : 'Personal archive';
const railSecondary = currentNav === 'home' ? copy.branding.title : copy.nav[currentNav];
const themeBootstrap = `(() => {
  const key = 'ylb-theme';
  try {
    const saved = localStorage.getItem(key);
    const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    const theme = saved || system;
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    document.documentElement.dataset.reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'true' : 'false';
  } catch {
    document.documentElement.dataset.theme = 'dark';
    document.documentElement.style.colorScheme = 'dark';
    document.documentElement.dataset.reduceMotion = 'false';
  }
})();`;
const localeScript = `(() => {
  const key = 'ylb-locale';
  try {
    localStorage.setItem(key, '${locale}');
  } catch {}

  const bind = () => {
    document.querySelectorAll('[data-locale-choice]').forEach((link) => {
      if (link.dataset.bound === 'true') {
        return;
      }

      link.dataset.bound = 'true';
      link.addEventListener('click', () => {
        try {
          localStorage.setItem(key, link.dataset.localeChoice || '${locale}');
        } catch {}
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bind, { once: true });
  } else {
    bind();
  }
})();`;
const motionScript = `(() => {
  const root = document.documentElement;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const progressBar = document.querySelector('[data-site-progress]');
  const pointerAura = document.querySelector('[data-pointer-aura]');

  const updateProgress = () => {
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const progress = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
    root.style.setProperty('--scroll-progress', String(progress));
    if (progressBar) {
      progressBar.style.transform = 'scaleX(' + progress + ')';
    }
  };

  const revealBlocks = () => {
    const targets = [
      ...document.querySelectorAll('.page-main > *'),
      ...document.querySelectorAll('.posts-grid > *'),
      ...document.querySelectorAll('.card-grid--three > *'),
      ...document.querySelectorAll('.stack-grid > *'),
      ...document.querySelectorAll('.link-grid > *'),
      ...document.querySelectorAll('.catalog-sidebar > *'),
      ...document.querySelectorAll('.catalog-stage > *')
    ];

    if (prefersReduced || !('IntersectionObserver' in window)) {
      targets.forEach((node) => node.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.14, rootMargin: '0px 0px -8% 0px' });

    targets.forEach((node, index) => {
      node.classList.add('motion-block');
      node.style.setProperty('--motion-delay', String((index % 8) * 70) + 'ms');
      observer.observe(node);
    });
  };

  const bindTilt = () => {
    document.querySelectorAll('.panel, .surface, .post-card').forEach((card) => {
      if (card.dataset.tiltBound === 'true') return;
      if (card.dataset.tilt === 'off') return;
      card.dataset.tiltBound = 'true';
      card.classList.add('tilt-card');

      if (prefersReduced) return;

      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width;
        const py = (event.clientY - rect.top) / rect.height;
        const rotateY = (px - 0.5) * 10;
        const rotateX = (0.5 - py) * 10;

        card.style.setProperty('--tilt-x', rotateX.toFixed(2) + 'deg');
        card.style.setProperty('--tilt-y', rotateY.toFixed(2) + 'deg');
        card.style.setProperty('--glow-x', String(px * 100) + '%');
        card.style.setProperty('--glow-y', String(py * 100) + '%');
      });

      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--tilt-x');
        card.style.removeProperty('--tilt-y');
        card.style.removeProperty('--glow-x');
        card.style.removeProperty('--glow-y');
      });
    });
  };

  const bindPointerAura = () => {
    if (!pointerAura || prefersReduced || window.matchMedia('(pointer: coarse)').matches) {
      if (pointerAura) pointerAura.hidden = true;
      return;
    }

    let raf = 0;
    let nextX = window.innerWidth / 2;
    let nextY = window.innerHeight / 2;

    const render = () => {
      pointerAura.style.setProperty('--pointer-x', nextX + 'px');
      pointerAura.style.setProperty('--pointer-y', nextY + 'px');
      raf = 0;
    };

    window.addEventListener('pointermove', (event) => {
      nextX = event.clientX;
      nextY = event.clientY;
      if (!raf) {
        raf = requestAnimationFrame(render);
      }
    });
  };

  const init = () => {
    updateProgress();
    revealBlocks();
    bindTilt();
    bindPointerAura();

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
})();`;
---

<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111316" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={getDictionary(locale).branding.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title}</title>
    <script is:inline set:html={themeBootstrap}></script>
    <slot name="head" />
  </head>
  <body>
    <div class="site-progress" aria-hidden="true">
      <span data-site-progress></span>
    </div>
    <div class="pointer-aura" data-pointer-aura aria-hidden="true"></div>

    <div class="site-backdrop" aria-hidden="true">
      <div class="site-backdrop__mesh"></div>
      <div class="site-backdrop__glow site-backdrop__glow--one"></div>
      <div class="site-backdrop__glow site-backdrop__glow--two"></div>
    </div>

    <div class="page-shell">
      <div class="page-shell__rail page-shell__rail--left" aria-hidden="true">
        <span>{railPrimary}</span>
      </div>
      <div class="page-shell__rail page-shell__rail--right" aria-hidden="true">
        <span>{railSecondary}</span>
      </div>

      {showHeader && <SiteHeader locale={locale} currentNav={currentNav} paths={paths} />}
      <main class="page-main">
        <slot />
      </main>
      {showFooter && <SiteFooter locale={locale} />}
    </div>

    <script is:inline set:html={localeScript}></script>
    <script is:inline set:html={motionScript}></script>
  </body>
</html>
