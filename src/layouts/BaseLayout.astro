---
import '../styles/global.css';
import { localePath, withBase } from '../lib/routing';
import type { Locale } from '../data/site';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  switchHref: string;
  switchLabel: string;
}

const { title, description, locale, switchHref, switchLabel } = Astro.props;

const nav = locale === 'zh'
  ? [
      { label: '\u9996\u9875', href: localePath('zh') },
      { label: '\u7cfb\u5217', href: localePath('zh', 'series') },
      { label: '\u641c\u7d22', href: localePath('zh', 'search') },
      { label: '\u5173\u4e8e', href: localePath('zh', 'about') }
    ]
  : [
      { label: 'Home', href: localePath('en') },
      { label: 'Series', href: localePath('en', 'series') },
      { label: 'Search', href: localePath('en', 'search') },
      { label: 'About', href: localePath('en', 'about') }
    ];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={localePath(locale)}>
          <span class="brand-mark">M</span>
          <span>
            <strong>MUZI</strong>
            <small>Yang's Blogs</small>
          </span>
        </a>

        <nav class="site-nav" aria-label={locale === 'zh' ? '\u4e3b\u5bfc\u822a' : 'Primary'}>
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>

        <a class="switch-link" href={switchHref}>{switchLabel}</a>
      </header>

      <main class="page">
        <slot />
      </main>

      <footer class="site-footer">
        <p>
          {locale === 'zh'
            ? '\u7b2c\u4e00\u7248\u9aa8\u67b6\u548c GitHub \u8bc4\u8bba\u5df2\u7ecf\u63a5\u597d\uff0c\u4e0b\u4e00\u6b65\u4f1a\u7ee7\u7eed\u63a5 Feishu \u5185\u5bb9\u540c\u6b65\u3002'
            : 'The first release now includes the blog skeleton and GitHub-backed comments. Next comes Feishu content sync.'}
        </p>
      </footer>
    </div>
  </body>
</html>
