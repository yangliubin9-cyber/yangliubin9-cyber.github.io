---
import '../styles/global.css';
import { siteMeta, type Locale } from '../data/site';
import { getUiText, languageCodes } from '../data/ui';
import { localePath, withBase } from '../lib/routing';
import { themeModes } from '../lib/theme';

type StructuredData = Record<string, unknown>;

interface Props {
  title: string;
  description: string;
  locale: Locale;
  switchHref?: string;
  switchLabel?: string;
  ogType?: 'website' | 'article';
  imagePath?: string;
  noIndex?: boolean;
  publishedTime?: string;
  keywords?: string[];
  structuredData?: StructuredData | StructuredData[];
}

const {
  title,
  description,
  locale,
  switchHref,
  ogType = 'website',
  imagePath = siteMeta.socialImage,
  noIndex = false,
  publishedTime,
  keywords = [],
  structuredData
} = Astro.props;
const ui = getUiText(locale);
const nav = [
  { label: ui.layout.nav.home, href: localePath(locale) },
  { label: ui.layout.nav.series, href: localePath(locale, 'series') },
  { label: ui.layout.nav.search, href: localePath(locale, 'search') },
  { label: ui.layout.nav.about, href: localePath(locale, 'about') }
];
const translationUnavailableLabel =
  locale === 'zh'
    ? '目标语言暂时还没有同步内容。'
    : 'This locale is not available for the current page yet.';
const languageOptions = [
  {
    code: languageCodes.zh,
    href: locale === 'zh' ? localePath('zh') : switchHref,
    active: locale === 'zh',
    available: locale === 'zh' || Boolean(switchHref)
  },
  {
    code: languageCodes.en,
    href: locale === 'en' ? localePath('en') : switchHref,
    active: locale === 'en',
    available: locale === 'en' || Boolean(switchHref)
  }
];
const themeOptions = themeModes.map((mode) => ({
  mode,
  label: ui.layout.themeNames[mode]
}));
const lang = locale === 'zh' ? 'zh-CN' : 'en';
const preferencesAria = `${ui.layout.languageLabel} / ${ui.layout.themeLabel}`;
const siteOrigin = Astro.site ?? new URL(siteMeta.url);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const alternateUrl = switchHref ? new URL(switchHref, siteOrigin).toString() : undefined;
const socialImageUrl = new URL(withBase(imagePath), siteOrigin).toString();
const ogLocale = locale === 'zh' ? 'zh_CN' : 'en_US';
const alternateLocale = locale === 'zh' ? 'en_US' : 'zh_CN';
const baseStructuredData: StructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${siteMeta.brand} | ${siteMeta.title}`,
  url: siteMeta.url,
  description,
  inLanguage: ['zh-CN', 'en-US'],
  publisher: {
    '@type': 'Person',
    name: siteMeta.author.name,
    url: siteMeta.author.github
  }
};
const structuredDataItems = [
  baseStructuredData,
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [])
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex,nofollow' : 'index,follow'} />
    <meta name="theme-color" content="#9a4a18" />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    {alternateUrl && (
      <link rel="alternate" hreflang={locale === 'zh' ? 'en' : 'zh'} href={alternateUrl} />
    )}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:site_name" content={`${siteMeta.brand} | ${siteMeta.title}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    {alternateUrl && <meta property="og:locale:alternate" content={alternateLocale} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' &&
      keywords.map((keyword) => <meta property="article:tag" content={keyword} />)}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredDataItems)} />
    <script is:inline>
      const storageKey = 'muzi-theme';
      const utterancesTheme = {
        light: 'github-light',
        dark: 'github-dark'
      };
      const root = document.documentElement;
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

      const getStoredTheme = () => {
        const storedTheme = localStorage.getItem(storageKey);
        return storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : null;
      };

      const getActiveTheme = () => (root.dataset.theme === 'dark' ? 'dark' : 'light');

      const updateThemeButtons = (theme) => {
        document.querySelectorAll('[data-theme-option]').forEach((button) => {
          const isActive = button.getAttribute('data-theme-option') === theme;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
      };

      const setPreferencesMenuState = (menu, open) => {
        if (!(menu instanceof HTMLElement)) {
          return;
        }

        const toggle = menu.querySelector('[data-preferences-toggle]');
        const panel = menu.querySelector('[data-preferences-panel]');

        menu.dataset.open = String(open);

        if (toggle instanceof HTMLButtonElement) {
          toggle.setAttribute('aria-expanded', String(open));
        }

        if (panel instanceof HTMLElement) {
          panel.hidden = !open;
        }
      };

      const closePreferencesMenus = () => {
        document.querySelectorAll('[data-preferences-menu]').forEach((menu) => {
          if (menu instanceof HTMLElement) {
            setPreferencesMenuState(menu, false);
          }
        });
      };

      const syncUtterancesTheme = (theme) => {
        const frame = document.querySelector('.utterances-frame');
        frame?.contentWindow?.postMessage(
          {
            type: 'set-theme',
            theme: utterancesTheme[theme] ?? utterancesTheme.light
          },
          'https://utteranc.es'
        );
      };

      const applyTheme = (theme, persist = true) => {
        root.dataset.theme = theme;
        root.style.colorScheme = theme;

        if (persist) {
          localStorage.setItem(storageKey, theme);
        }

        updateThemeButtons(theme);
        syncUtterancesTheme(theme);
        window.dispatchEvent(new CustomEvent('muzi:theme-change', { detail: { theme } }));
      };

      const resolveTheme = () => getStoredTheme() ?? (mediaQuery.matches ? 'dark' : 'light');
      applyTheme(resolveTheme(), false);

      document.addEventListener('DOMContentLoaded', () => {
        updateThemeButtons(getActiveTheme());
        closePreferencesMenus();
      });

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) {
          return;
        }

        const toggle = event.target.closest('[data-preferences-toggle]');
        if (toggle instanceof HTMLButtonElement) {
          const menu = toggle.closest('[data-preferences-menu]');
          if (menu instanceof HTMLElement) {
            const isOpen = menu.dataset.open === 'true';
            closePreferencesMenus();
            setPreferencesMenuState(menu, !isOpen);
          }
          return;
        }

        const button = event.target.closest('[data-theme-option]');

        if (button instanceof HTMLButtonElement) {
          const theme = button.getAttribute('data-theme-option');
          if (theme !== 'light' && theme !== 'dark') {
            return;
          }

          applyTheme(theme, true);
          const menu = button.closest('[data-preferences-menu]');
          if (menu instanceof HTMLElement) {
            setPreferencesMenuState(menu, false);
          }
          return;
        }

        document.querySelectorAll('[data-preferences-menu]').forEach((menu) => {
          if (menu instanceof HTMLElement && menu.dataset.open === 'true' && !menu.contains(event.target)) {
            setPreferencesMenuState(menu, false);
          }
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closePreferencesMenus();
        }
      });

      if (typeof mediaQuery.addEventListener === 'function') {
        mediaQuery.addEventListener('change', (event) => {
          if (!getStoredTheme()) {
            applyTheme(event.matches ? 'dark' : 'light', false);
          }
        });
      }
    </script>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={localePath(locale)}>
          <span class="brand-mark">M</span>
          <span>
            <strong>MUZI</strong>
            <small>Yang's Blogs</small>
          </span>
        </a>

        <nav class="site-nav" aria-label={ui.layout.navAria}>
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>

        <div class="site-tools">
          <div class="preferences-menu" data-preferences-menu data-open="false">
            <button
              class="preferences-toggle"
              type="button"
              aria-label={preferencesAria}
              aria-haspopup="true"
              aria-expanded="false"
              data-preferences-toggle
            >
              <span class="preferences-current">{locale.toUpperCase()}</span>
              <span class="preferences-theme-icon" aria-hidden="true"></span>
              <span class="preferences-chevron" aria-hidden="true"></span>
            </button>

            <div class="preferences-panel" data-preferences-panel hidden>
              <div class="preferences-section">
                <span class="preferences-label">{ui.layout.languageLabel}</span>
                <div class="segmented-control" aria-label={ui.layout.languageLabel}>
                  {languageOptions.map((item) =>
                    item.active ? (
                      <span class="segmented-option is-active" aria-current="page">
                        {item.code}
                      </span>
                    ) : !item.available ? (
                      <span
                        class="segmented-option is-disabled"
                        aria-disabled="true"
                        title={translationUnavailableLabel}
                      >
                        {item.code}
                      </span>
                    ) : (
                      <a class="segmented-option" href={item.href}>
                        {item.code}
                      </a>
                    )
                  )}
                </div>
              </div>

              <div class="preferences-section">
                <span class="preferences-label">{ui.layout.themeLabel}</span>
                <div class="segmented-control" aria-label={ui.layout.themeLabel}>
                  {themeOptions.map((item) => (
                    <button
                      class="segmented-option"
                      type="button"
                      data-theme-option={item.mode}
                      aria-pressed="false"
                    >
                      {item.label}
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      <main class="page">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-panel">
          <div class="footer-copy">
            <p class="footer-brand">{siteMeta.brand} · {siteMeta.title}</p>
            <p class="footer-tagline">{siteMeta.description[locale]}</p>
            <p class="footer-copyright">© {new Date().getFullYear()} {siteMeta.author.name}</p>
          </div>
          <div class="footer-links">
            <a class="footer-link" href={siteMeta.author.github} target="_blank" rel="noreferrer">GitHub</a>
            <a class="footer-link" href={siteMeta.repositories.site} target="_blank" rel="noreferrer">
              {locale === 'zh' ? '本站源码' : 'Source'}
            </a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
