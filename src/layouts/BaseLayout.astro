---
import '../styles/global.css';
import { localePath, withBase } from '../lib/routing';
import type { Locale } from '../data/site';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  switchHref: string;
  switchLabel: string;
}

const { title, description, locale, switchHref, switchLabel } = Astro.props;

const nav = locale === 'zh'
  ? [
      { label: '首页', href: localePath('zh') },
      { label: '系列', href: localePath('zh', 'series') },
      { label: '搜索', href: localePath('zh', 'search') },
      { label: '关于', href: localePath('zh', 'about') }
    ]
  : [
      { label: 'Home', href: localePath('en') },
      { label: 'Series', href: localePath('en', 'series') },
      { label: 'Search', href: localePath('en', 'search') },
      { label: 'About', href: localePath('en', 'about') }
    ];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={localePath(locale)}>
          <span class="brand-mark">M</span>
          <span>
            <strong>MUZI</strong>
            <small>Yang's Blogs</small>
          </span>
        </a>

        <nav class="site-nav" aria-label={locale === 'zh' ? '主导航' : 'Primary'}>
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>

        <a class="switch-link" href={switchHref}>{switchLabel}</a>
      </header>

      <main class="page">
        <slot />
      </main>

      <footer class="site-footer">
        <p>
          {locale === 'zh'
            ? 'V1 骨架已经建立，下一步是接入 Feishu 内容同步与 Supabase 评论链路。'
            : 'The V1 skeleton is now in place. Next comes Feishu content sync and the Supabase comment flow.'}
        </p>
      </footer>
    </div>
  </body>
</html>
