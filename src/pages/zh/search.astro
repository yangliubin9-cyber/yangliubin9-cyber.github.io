---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getReadingLabel } from '../../lib/content';
import { localePath } from '../../lib/routing';
import { getSeriesBySlug, getSeriesName, series, siteMeta } from '../../data/site';
import { getUiText } from '../../data/ui';

const posts = await getPosts('zh');
const searchUi = getUiText('zh').search;
const pageSize = 8;
const searchCountTemplates = {
  all: '当前展示全部 {total} 篇文章。',
  filtered: '筛选结果：{visible} / {total} 篇文章。'
};
const searchPaginationUi = {
  previous: '上一页',
  next: '下一页',
  status: '第 {page} / {totalPages} 页',
  aria: '搜索结果分页'
};
const seriesOptions = series.map((item) => ({
  slug: item.slug,
  label: getSeriesName('zh', item),
  count: posts.filter((post) => post.data.series === item.slug).length
}));
---

<BaseLayout
  title="搜索"
  description={siteMeta.description.zh}
  locale="zh"
  switchHref={localePath('en', 'search')}
  noIndex={true}
>
  <section class="hero hero-editorial">
    <span class="kicker">{searchUi.kicker}</span>
    <h1 class="title page-title">{searchUi.title}</h1>
  </section>

  <section
    class="section search-shell"
    data-search-all-template={searchCountTemplates.all}
    data-search-filtered-template={searchCountTemplates.filtered}
    data-search-page-status-template={searchPaginationUi.status}
    data-search-page-size={pageSize}
  >
    <div class="search-toolbar">
      <label class="search-label" for="post-search-zh">{searchUi.label}</label>
      <div class="search-input-row">
        <input
          id="post-search-zh"
          class="search-input"
          type="search"
          placeholder={searchUi.placeholder}
          data-search-input
        />
        <button class="search-clear" type="button" data-search-clear disabled>{searchUi.clear}</button>
      </div>
      <div class="search-toolbar-meta">
        <p class="muted" data-search-count>{searchUi.allCount(posts.length)}</p>
      </div>
    </div>

    <div class="search-filters" aria-label={searchUi.filtersAria}>
      <button class="filter-chip is-active" type="button" data-series-filter="">
        {searchUi.allFilter}
        <span data-filter-count>{posts.length}</span>
      </button>
      {seriesOptions.map((item) => (
        <button class="filter-chip" type="button" data-series-filter={item.slug}>
          {item.label}
          <span data-filter-count>{item.count}</span>
        </button>
      ))}
    </div>

    <div class="grid search-grid" data-search-results>
      {posts.map((post) => {
        const seriesItem = getSeriesBySlug(post.data.series);
        return (
          <a
            class="card card-post"
            href={localePath('zh', post.data.pathSlug)}
            data-search-item
            data-search-series={post.data.series}
            data-search-text={`${post.data.title} ${post.data.summary} ${post.data.tags.join(' ')} ${
              seriesItem ? getSeriesName('zh', seriesItem) : ''
            }`.toLowerCase()}
          >
            {seriesItem && (
              <span class="pill card-pill" title={getSeriesName('zh', seriesItem)}>
                {getSeriesName('zh', seriesItem)}
              </span>
            )}
            <h3>{post.data.title}</h3>
            <p class="muted">{post.data.summary}</p>
            <strong>{getReadingLabel('zh', post.data.readingMinutes)}</strong>
          </a>
        );
      })}
    </div>

    <div class="search-pagination" data-search-pagination aria-label={searchPaginationUi.aria} hidden>
      <button class="search-page-button" type="button" data-search-prev disabled>
        {searchPaginationUi.previous}
      </button>
      <div class="search-page-list" data-search-page-list></div>
      <button class="search-page-button" type="button" data-search-next disabled>
        {searchPaginationUi.next}
      </button>
    </div>

    <p class="search-page-status muted" data-search-page-status hidden></p>
    <p class="search-empty muted" data-search-empty hidden>{searchUi.empty}</p>

    <script is:inline>
      (() => {
        const searchRoot = document.querySelector('.search-shell');
        if (!(searchRoot instanceof HTMLElement)) return;

        const input = searchRoot.querySelector('[data-search-input]');
        const clearButton = searchRoot.querySelector('[data-search-clear]');
        const count = searchRoot.querySelector('[data-search-count]');
        const allTemplate =
          searchRoot.getAttribute('data-search-all-template') ?? 'Showing all {total} posts.';
        const filteredTemplate =
          searchRoot.getAttribute('data-search-filtered-template') ??
          'Showing {visible} of {total} posts.';
        const pageStatusTemplate =
          searchRoot.getAttribute('data-search-page-status-template') ??
          'Page {page} of {totalPages}';
        const pageSize = Math.max(1, Number(searchRoot.getAttribute('data-search-page-size') ?? '8'));
        const items = Array.from(searchRoot.querySelectorAll('[data-search-item]'));
        const filters = Array.from(searchRoot.querySelectorAll('[data-series-filter]'));
        const pagination = searchRoot.querySelector('[data-search-pagination]');
        const pageList = searchRoot.querySelector('[data-search-page-list]');
        const pageStatus = searchRoot.querySelector('[data-search-page-status]');
        const prevButton = searchRoot.querySelector('[data-search-prev]');
        const nextButton = searchRoot.querySelector('[data-search-next]');
        const empty = searchRoot.querySelector('[data-search-empty]');
        const total = items.length;
        let activeSeries = '';
        let currentPage = 1;

        const formatTemplate = (template, values) =>
          Object.entries(values).reduce(
            (result, [key, value]) => result.replaceAll(`{${key}}`, String(value)),
            template
          );

        const getQuery = () =>
          input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : '';

        const matchesQuery = (item, query) => {
          const text = item.getAttribute('data-search-text') ?? '';
          return !query || text.includes(query);
        };

        const matchesSeries = (item, series) => {
          const itemSeries = item.getAttribute('data-search-series') ?? '';
          return !series || itemSeries === series;
        };

        const updateActiveFilter = () => {
          filters.forEach((filter) => {
            const value = filter.getAttribute('data-series-filter') ?? '';
            filter.classList.toggle('is-active', value === activeSeries);
            filter.setAttribute('aria-pressed', String(value === activeSeries));
          });
        };

        const updateCount = (visible, hasFilter) => {
          if (!count) return;

          count.textContent = hasFilter
            ? formatTemplate(filteredTemplate, { visible, total })
            : formatTemplate(allTemplate, { total });
        };

        const updateFilterCounts = (query) => {
          const countsBySeries = new Map();
          let queryMatchedTotal = 0;

          items.forEach((item) => {
            if (!matchesQuery(item, query)) return;

            queryMatchedTotal += 1;

            const itemSeries = item.getAttribute('data-search-series') ?? '';
            countsBySeries.set(itemSeries, (countsBySeries.get(itemSeries) ?? 0) + 1);
          });

          filters.forEach((filter) => {
            const value = filter.getAttribute('data-series-filter') ?? '';
            const badge = filter.querySelector('[data-filter-count]');
            const filterCount = value ? (countsBySeries.get(value) ?? 0) : queryMatchedTotal;

            if (badge) {
              badge.textContent = String(filterCount);
            }

            filter.toggleAttribute('data-empty', filterCount === 0);
          });
        };

        const updatePagination = (visible) => {
          const totalPages = Math.max(1, Math.ceil(visible / pageSize));
          const shouldPaginate = visible > pageSize;

          if (pagination instanceof HTMLElement) {
            pagination.hidden = !shouldPaginate;
          }

          if (pageStatus instanceof HTMLElement) {
            pageStatus.hidden = !shouldPaginate;
            pageStatus.textContent = shouldPaginate
              ? formatTemplate(pageStatusTemplate, { page: currentPage, totalPages })
              : '';
          }

          if (prevButton instanceof HTMLButtonElement) {
            prevButton.disabled = !shouldPaginate || currentPage === 1;
          }

          if (nextButton instanceof HTMLButtonElement) {
            nextButton.disabled = !shouldPaginate || currentPage === totalPages;
          }

          if (!(pageList instanceof HTMLElement)) return totalPages;

          if (!shouldPaginate) {
            pageList.replaceChildren();
            return totalPages;
          }

          const pageButtons = [];

          for (let page = 1; page <= totalPages; page += 1) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'search-page-button';
            button.textContent = String(page);
            button.classList.toggle('is-active', page === currentPage);

            if (page === currentPage) {
              button.setAttribute('aria-current', 'page');
            }

            button.addEventListener('click', () => {
              currentPage = page;
              applyFilter();
            });

            pageButtons.push(button);
          }

          pageList.replaceChildren(...pageButtons);

          return totalPages;
        };

        const applyFilter = (resetPage = false) => {
          const query = getQuery();
          const hasFilter = Boolean(query || activeSeries);

          updateFilterCounts(query);

          const matchedItems = items.filter(
            (item) => matchesQuery(item, query) && matchesSeries(item, activeSeries)
          );
          const visible = matchedItems.length;

          if (resetPage) {
            currentPage = 1;
          }

          const totalPages = Math.max(1, Math.ceil(visible / pageSize));
          currentPage = Math.min(currentPage, totalPages);

          const startIndex = (currentPage - 1) * pageSize;
          const currentItems = new Set(matchedItems.slice(startIndex, startIndex + pageSize));

          items.forEach((item) => {
            item.toggleAttribute('hidden', !currentItems.has(item));
          });

          updateCount(visible, hasFilter);
          updatePagination(visible);

          if (empty) {
            empty.toggleAttribute('hidden', visible !== 0);
          }

          if (clearButton instanceof HTMLButtonElement) {
            clearButton.disabled = !hasFilter;
          }
        };

        filters.forEach((filter) => {
          filter.addEventListener('click', () => {
            const value = filter.getAttribute('data-series-filter') ?? '';
            activeSeries = activeSeries === value ? '' : value;
            updateActiveFilter();
            applyFilter(true);
          });
        });

        input?.addEventListener('input', () => {
          applyFilter(true);
        });

        prevButton?.addEventListener('click', () => {
          currentPage = Math.max(1, currentPage - 1);
          applyFilter();
        });

        nextButton?.addEventListener('click', () => {
          currentPage += 1;
          applyFilter();
        });

        clearButton?.addEventListener('click', () => {
          if (input instanceof HTMLInputElement) {
            input.value = '';
            input.focus();
          }

          activeSeries = '';
          currentPage = 1;
          updateActiveFilter();
          applyFilter(true);
        });

        updateActiveFilter();
        applyFilter(true);
      })();
    </script>
  </section>
</BaseLayout>
