---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePath } from '../../lib/routing';
import { siteMeta } from '../../data/site';
import { getUiText } from '../../data/ui';

const aboutUi = getUiText('zh').about;
const aboutStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: '关于 MUZI',
  description: siteMeta.description.zh,
  url: new URL(localePath('zh', 'about'), siteMeta.url).toString(),
  inLanguage: 'zh-CN',
  mainEntity: {
    '@type': 'Person',
    name: siteMeta.author.name,
    url: siteMeta.author.github
  }
};
---

<BaseLayout
  title="关于 MUZI"
  description={siteMeta.description.zh}
  locale="zh"
  switchHref={localePath('en', 'about')}
  keywords={['关于作者', 'AI 基础设施', '云原生', '工程博客']}
  structuredData={aboutStructuredData}
>
  <section class="hero">
    <span class="kicker">{aboutUi.kicker}</span>
    <h1 class="title">{aboutUi.title}</h1>
    <p class="lede">{aboutUi.lede}</p>
  </section>

  <section class="article-body">
    {aboutUi.paragraphs.map((item) => (
      <p>{item}</p>
    ))}
  </section>
</BaseLayout>
