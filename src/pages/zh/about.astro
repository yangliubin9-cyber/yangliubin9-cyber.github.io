---
import AboutPage from '../../components/AboutPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePath } from '../../lib/routing';
import { siteMeta } from '../../data/site';

const aboutStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: '关于 MUZI',
  description: siteMeta.description.zh,
  url: new URL(localePath('zh', 'about'), siteMeta.url).toString(),
  inLanguage: 'zh-CN',
  mainEntity: {
    '@type': 'Person',
    name: siteMeta.author.name,
    url: siteMeta.author.github
  }
};

const aboutContent = {
  kicker: '关于',
  title: '在 AI、平台与运维交界处写工程博客',
  lede:
    '我是杨刘彬，网名 MUZI。这个页面我想尽量写得简单一点，像一个真实的人在介绍自己，而不是像一段网站说明。',
  aboutEyebrow: '关于我',
  aboutTitle: '我更愿意把自己看成一个长期在做工程实践记录的人',
  aboutParagraphs: [
    {
      text: '我平时关注的方向比较集中，主要是 AI 基础设施、MLOps、Kubernetes、Docker、CI/CD，以及这些东西真正落到交付和运维时会遇到的问题。相比只记命令，我更在意为什么这样做、这样做的代价是什么。'
    },
    {
      text: '做这个博客，一开始是因为我发现很多经验如果不及时整理，很快就会重新踩一遍。后来慢慢变成另一件事，就是把这些原本零散的实践笔记，整理成别人也能顺着读下去、拿去复用的内容。'
    },
    {
      text: '如果你在这里继续看下去，你会发现我写东西的口味很明确。少一点空泛概念，多一点具体判断。比如什么时候该上 Kubernetes，什么时候其实应该先把基础交付链路打稳，哪些问题表面上像是工具问题，实际上是架构和平台边界没想清楚。'
    }
  ],
  contactEyebrow: '联系我',
  contactTitle: '如果你想交流技术、博客内容或合作，可以直接联系我',
  contactSummary: '我更偏好直接、明确的沟通方式。邮件适合正式联系，GitHub 适合讨论文章、代码和项目本身。',
  contactItems: [
    {
      label: '邮箱',
      value: 'yangliubin9@gmail.com',
      href: 'mailto:yangliubin9@gmail.com',
      note: '适合正式联系、合作沟通，或者直接给我反馈这个站点的内容。'
    },
    {
      label: 'GitHub',
      value: 'github.com/yangliubin9-cyber',
      href: 'https://github.com/yangliubin9-cyber',
      note: '适合看代码、开 issue，或者围绕文章内容继续讨论。'
    }
  ]
};
---

<BaseLayout
  title="关于 MUZI"
  description={siteMeta.description.zh}
  locale="zh"
  switchHref={localePath('en', 'about')}
  keywords={['关于作者', 'AI 基础设施', '云原生', '工程博客']}
  structuredData={aboutStructuredData}
>
  <AboutPage content={aboutContent} />
</BaseLayout>
