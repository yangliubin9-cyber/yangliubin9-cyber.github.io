---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePath } from '../../lib/routing';
import { siteMeta } from '../../data/site';
import { getUiText } from '../../data/ui';

const aboutUi = getUiText('zh').about;
---

<BaseLayout
  title="关于 MUZI"
  description={siteMeta.description.zh}
  locale="zh"
  switchHref={localePath('en', 'about')}
>
  <section class="hero">
    <span class="kicker">{aboutUi.kicker}</span>
    <h1 class="title">{aboutUi.title}</h1>
    <p class="lede">{aboutUi.lede}</p>
  </section>

  <section class="article-body">
    {aboutUi.paragraphs.map((item) => (
      <p>{item}</p>
    ))}
  </section>
</BaseLayout>
