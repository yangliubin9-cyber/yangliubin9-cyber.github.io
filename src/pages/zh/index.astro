---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFeaturedPosts, getReadingLabel } from '../../lib/content';
import { localePath } from '../../lib/routing';
import { getSeriesBySlug, getSeriesName, siteMeta } from '../../data/site';
import { getUiText } from '../../data/ui';

const featuredPosts = await getFeaturedPosts('zh');
const homeUi = getUiText('zh').home;
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'MUZI | AI 基础设施与工程实践',
  description: siteMeta.description.zh,
  url: new URL(localePath('zh'), siteMeta.url).toString(),
  inLanguage: 'zh-CN',
  isPartOf: {
    '@type': 'WebSite',
    name: `${siteMeta.brand} | ${siteMeta.title}`,
    url: siteMeta.url
  }
};
---

<BaseLayout
  title="MUZI | AI 基础设施与工程实践"
  description={siteMeta.description.zh}
  locale="zh"
  switchHref={localePath('en')}
  keywords={['AI 基础设施', 'MLOps', 'Kubernetes', 'Docker', '工程实践']}
  structuredData={homeStructuredData}
>
  <section class="hero hero-editorial">
    <span class="kicker">{homeUi.kicker}</span>
    <h1 class="title">{homeUi.title}</h1>
    <div class="hero-actions">
      <a class="button-link primary" href="#featured-posts">{homeUi.primaryAction}</a>
      <a class="button-link" href={localePath('zh', 'about')}>{homeUi.secondaryAction}</a>
    </div>
  </section>

  <section class="section" id="featured-posts">
    <div class="section-header">
      <div>
        <span class="eyebrow">{homeUi.featuredEyebrow}</span>
        <h2>{homeUi.featuredTitle}</h2>
      </div>
    </div>

    <div class="grid">
      {featuredPosts.map((post) => {
        const seriesItem = getSeriesBySlug(post.data.series);
        return (
          <a class="card card-post" href={localePath('zh', post.data.pathSlug)}>
            <span class="pill">
              {seriesItem ? getSeriesName('zh', seriesItem) : homeUi.fallbackBadge}
            </span>
            <h3>{post.data.title}</h3>
            <p class="muted">{post.data.summary}</p>
            <strong>{getReadingLabel('zh', post.data.readingMinutes)}</strong>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
