---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeriesTracks } from '../../lib/content';
import { localePath } from '../../lib/routing';
import { getSeriesDescription, getSeriesName, siteMeta } from '../../data/site';
import { getUiText } from '../../data/ui';

const seriesTracks = await getSeriesTracks('zh');
const homeUi = getUiText('zh').home;
const trackCount = homeUi.trackCount ?? ((count: number) => `${count} 篇文章`);
const trackLatestLabel = homeUi.trackLatestLabel ?? '最新更新';
const trackEntryAction = homeUi.trackEntryAction ?? '从这篇开始';
const trackSeriesAction = homeUi.trackSeriesAction ?? '查看系列';
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'MUZI | AI 基础设施与工程实践',
  description: siteMeta.description.zh,
  url: new URL(localePath('zh'), siteMeta.url).toString(),
  inLanguage: 'zh-CN',
  isPartOf: {
    '@type': 'WebSite',
    name: `${siteMeta.brand} | ${siteMeta.title}`,
    url: siteMeta.url
  }
};
---

<BaseLayout
  title="MUZI | AI 基础设施与工程实践"
  description={siteMeta.description.zh}
  locale="zh"
  switchHref={localePath('en')}
  keywords={['AI 基础设施', 'MLOps', 'Kubernetes', 'Docker', '工程实践']}
  structuredData={homeStructuredData}
>
  <section class="hero hero-editorial">
    <span class="kicker">{homeUi.kicker}</span>
    <h1 class="title page-title">{homeUi.title}</h1>
    <p class="lede">{homeUi.lede}</p>
    <div class="hero-actions">
      <a class="button-link primary" href="#featured-posts">{homeUi.primaryAction}</a>
      <a class="button-link" href={localePath('zh', 'about')}>{homeUi.secondaryAction}</a>
    </div>
  </section>

  <section class="section" id="featured-posts">
    <div class="section-header section-header-stack">
      <div>
        <span class="eyebrow">{homeUi.featuredEyebrow}</span>
        <h2>{homeUi.featuredTitle}</h2>
      </div>
      <p class="section-summary">{homeUi.featuredSummary}</p>
    </div>

    <div class="track-grid">
      {seriesTracks.map(({ seriesItem, featuredPost, latestPost, posts }) => {
        return (
          <article class="card card-track">
            <div class="track-topline">
              <span class="pill card-pill" title={getSeriesName('zh', seriesItem)}>
                {getSeriesName('zh', seriesItem)}
              </span>
              <span class="track-count">{trackCount(posts.length)}</span>
            </div>

            <div class="track-copy">
              <h3>{featuredPost.data.title}</h3>
              <p class="muted">{featuredPost.data.summary}</p>
              <p class="track-description">{getSeriesDescription('zh', seriesItem)}</p>
            </div>

            <a class="track-link" href={localePath('zh', latestPost.data.pathSlug)}>
              <span class="track-label">{trackLatestLabel}</span>
              <strong>{latestPost.data.title}</strong>
              <p>{latestPost.data.summary}</p>
            </a>

            <div class="track-actions">
              <a class="button-link primary" href={localePath('zh', featuredPost.data.pathSlug)}>
                {trackEntryAction}
              </a>
              <a class="button-link" href={localePath('zh', `series/${seriesItem.slug}`)}>
                {trackSeriesAction}
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
