---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  formatPublishDate,
  getDisplaySummary,
  getPostsBySeries,
  getReadingLabel,
  type PostEntry
} from '../../../lib/content';
import { localePath } from '../../../lib/routing';
import { getSeriesDescription, getSeriesName, series, type Series } from '../../../data/site';
import { getUiText } from '../../../data/ui';

export async function getStaticPaths() {
  return Promise.all(
    series.map(async (item) => ({
      params: { series_slug: item.slug },
      props: {
        seriesItem: item,
        seriesPosts: await getPostsBySeries('zh', item.slug, 'asc')
      }
    }))
  );
}

const { seriesItem, seriesPosts } = Astro.props as {
  seriesItem: Series;
  seriesPosts: PostEntry[];
};

const seriesDetailUi = getUiText('zh').seriesDetail;
const startPost = seriesPosts[0];
const latestPost = [...seriesPosts].sort(
  (left, right) => right.data.publishedAt.getTime() - left.data.publishedAt.getTime()
)[0];
const overviewEyebrow = seriesDetailUi.overviewEyebrow ?? '阅读入口';
const overviewTitle = seriesDetailUi.overviewTitle ?? '先确定入口，再按顺序往下读';
const overviewSummary =
  seriesDetailUi.overviewSummary ??
  '第一次进入这个系列，先看起点文章；如果你已经在跟进更新，直接看最新一篇。';
const startLabel = seriesDetailUi.startLabel ?? '起点文章';
const latestLabel = seriesDetailUi.latestLabel ?? '最新更新';
const publishedLabel = seriesDetailUi.publishedLabel ?? '发布时间';
const readingTimeLabel = seriesDetailUi.readingTimeLabel ?? '阅读时长';
const readAction = seriesDetailUi.readAction ?? '打开文章';
const timelineEyebrow = seriesDetailUi.timelineEyebrow ?? '顺序阅读';
const timelineTitle = seriesDetailUi.timelineTitle ?? '按这条主线继续往下读';
const timelineSummary =
  seriesDetailUi.timelineSummary ??
  '每篇文章都按 seriesOrder 排好顺序，适合从前往后读，不需要自己猜先后。';
const stepLabel =
  seriesDetailUi.stepLabel ?? ((current: number, total: number) => `第 ${current} 篇，共 ${total} 篇`);
---

<BaseLayout
  title={`${getSeriesName('zh', seriesItem)} | 系列`}
  description={getSeriesDescription('zh', seriesItem)}
  locale="zh"
  switchHref={localePath('en', `series/${seriesItem.slug}`)}
>
  <section class="hero hero-editorial">
    <span class="kicker">{seriesDetailUi.kicker}</span>
    <h1 class="title page-title">{getSeriesName('zh', seriesItem)}</h1>
    <p class="lede">{getSeriesDescription('zh', seriesItem)}</p>
    <div class="hero-facts">
      <div class="fact-chip">
        <strong>{seriesPosts.length}</strong>
        <span>{seriesDetailUi.countLabel}</span>
      </div>
      {latestPost && (
        <div class="fact-chip">
          <strong>{formatPublishDate('zh', latestPost.data.publishedAt)}</strong>
          <span>{seriesDetailUi.latestPublishLabel}</span>
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="section-header section-header-stack">
      <div>
        <span class="eyebrow">{overviewEyebrow}</span>
        <h2>{overviewTitle}</h2>
      </div>
      <p class="section-summary">{overviewSummary}</p>
    </div>

    <div class="track-grid">
      {startPost && (
        <article class="card card-entry">
          <span class="track-label">{startLabel}</span>
          <h3>{startPost.data.title}</h3>
          <p class="muted">{getDisplaySummary(startPost.data.summary, startPost.data.title)}</p>
          <div class="entry-meta">
            <span>{publishedLabel} · {formatPublishDate('zh', startPost.data.publishedAt)}</span>
            <span>{readingTimeLabel} · {getReadingLabel('zh', startPost.data.readingMinutes)}</span>
          </div>
          <div class="track-actions">
            <a class="button-link primary" href={localePath('zh', startPost.data.pathSlug)}>
              {readAction}
            </a>
          </div>
        </article>
      )}

      {latestPost && (
        <article class="card card-entry">
          <span class="track-label">{latestLabel}</span>
          <h3>{latestPost.data.title}</h3>
          <p class="muted">{getDisplaySummary(latestPost.data.summary, latestPost.data.title)}</p>
          <div class="entry-meta">
            <span>{publishedLabel} · {formatPublishDate('zh', latestPost.data.publishedAt)}</span>
            <span>{readingTimeLabel} · {getReadingLabel('zh', latestPost.data.readingMinutes)}</span>
          </div>
          <div class="track-actions">
            <a class="button-link primary" href={localePath('zh', latestPost.data.pathSlug)}>
              {readAction}
            </a>
          </div>
        </article>
      )}
    </div>
  </section>

  <section class="section">
    <div class="section-header section-header-stack">
      <div>
        <span class="eyebrow">{timelineEyebrow}</span>
        <h2>{timelineTitle}</h2>
      </div>
      <p class="section-summary">{timelineSummary}</p>
    </div>

    <ol class="series-journey">
      {seriesPosts.map((post, index) => (
        <li class="series-journey-item">
          <span class="series-journey-step">{index + 1}</span>
          <article class="series-journey-card">
            <div class="series-journey-head">
              <div>
                <span class="track-label">{stepLabel(index + 1, seriesPosts.length)}</span>
                <h3>{post.data.title}</h3>
              </div>
              <div class="series-journey-meta">
                <span>{formatPublishDate('zh', post.data.publishedAt)}</span>
                <span>{getReadingLabel('zh', post.data.readingMinutes)}</span>
              </div>
            </div>
            <p class="muted">{getDisplaySummary(post.data.summary, post.data.title)}</p>
            <div class="track-actions">
              <a class="button-link" href={localePath('zh', post.data.pathSlug)}>{readAction}</a>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
