---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatPublishDate, getPosts, getReadingLabel, type PostEntry } from '../../../lib/content';
import { localePath } from '../../../lib/routing';
import { getSeriesDescription, getSeriesName, series, type Series } from '../../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts('zh');
  return series.map((item) => ({
    params: { series_slug: item.slug },
    props: {
      seriesItem: item,
      seriesPosts: posts.filter((post) => post.data.series === item.slug)
    }
  }));
}

const { seriesItem, seriesPosts } = Astro.props as {
  seriesItem: Series;
  seriesPosts: PostEntry[];
};
---

<BaseLayout
  title={`${getSeriesName('zh', seriesItem)} | 系列`}
  description={getSeriesDescription('zh', seriesItem)}
  locale="zh"
  switchHref={localePath('en', `series/${seriesItem.slug}`)}
  switchLabel="English"
>
  <section class="hero hero-editorial">
    <span class="kicker">Series Detail</span>
    <h1 class="title">{getSeriesName('zh', seriesItem)}</h1>
    <p class="lede">{getSeriesDescription('zh', seriesItem)}</p>
    <div class="hero-facts">
      <div class="fact-chip">
        <strong>{seriesPosts.length}</strong>
        <span>篇文章</span>
      </div>
      {seriesPosts[0] && (
        <div class="fact-chip">
          <strong>{formatPublishDate('zh', seriesPosts[0].data.publishedAt)}</strong>
          <span>最近发布时间</span>
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <ul class="list">
      {seriesPosts.map((post) => (
        <li>
          <a class="list-link" href={localePath('zh', post.data.pathSlug)}>
            <div class="list-head">
              <strong>{post.data.title}</strong>
              <span class="list-meta">{getReadingLabel('zh', post.data.readingMinutes)}</span>
            </div>
            <p class="muted">{post.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
