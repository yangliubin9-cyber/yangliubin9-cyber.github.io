---
import AboutPage from '../../components/AboutPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePath } from '../../lib/routing';
import { siteMeta } from '../../data/site';

const aboutStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About MUZI',
  description: siteMeta.description.en,
  url: new URL(localePath('en', 'about'), siteMeta.url).toString(),
  inLanguage: 'en-US',
  mainEntity: {
    '@type': 'Person',
    name: siteMeta.author.name,
    url: siteMeta.author.github
  }
};

const aboutContent = {
  kicker: 'About',
  title: 'Writing at the boundary of AI systems, platforms, and operations',
  lede:
    'I am Yang Liubin, also writing under the name MUZI. I want this page to read more like a real introduction from a real person, and less like site documentation.',
  aboutEyebrow: 'Get to Know Me',
  aboutTitle: 'I see myself as someone doing long-term engineering note taking in public',
  aboutParagraphs: [
    {
      text: 'Most of my attention goes to AI infrastructure, MLOps, Kubernetes, Docker, CI/CD, and the messy parts of delivery and operations that show up once systems leave the whiteboard. I care less about listing commands and more about the reasoning behind them.'
    },
    {
      text: 'This blog started as a way to stop losing useful experience. A lot of engineering lessons get re-learned because nobody writes them down while they are still fresh. Over time it became a place where I try to turn those scattered notes into something more durable and useful for other people too.'
    },
    {
      text: 'If you keep reading, you will probably notice my bias quickly. Less generic theory, more concrete judgment. When Kubernetes is worth the cost, when it is not. When a failure is really a tooling issue, and when it is actually a platform design problem wearing a tooling mask.'
    }
  ],
  contactEyebrow: 'Contact',
  contactTitle: 'If you want to talk about engineering, the blog, or possible collaboration, contact me directly',
  contactSummary: 'I prefer direct communication. Email is best for formal outreach. GitHub is better when the discussion is tied to code, articles, or project details.',
  contactItems: [
    {
      label: 'Email',
      value: 'yangliubin9@gmail.com',
      href: 'mailto:yangliubin9@gmail.com',
      note: 'Best for direct contact, collaboration, or feedback about the site and its writing.'
    },
    {
      label: 'GitHub',
      value: 'github.com/yangliubin9-cyber',
      href: 'https://github.com/yangliubin9-cyber',
      note: 'Best for code, issues, and continuing technical discussion around posts or projects.'
    }
  ]
};
---

<BaseLayout
  title="About MUZI"
  description={siteMeta.description.en}
  locale="en"
  switchHref={localePath('zh', 'about')}
  keywords={['about the author', 'AI infrastructure', 'cloud native', 'engineering blog']}
  structuredData={aboutStructuredData}
>
  <AboutPage content={aboutContent} />
</BaseLayout>
