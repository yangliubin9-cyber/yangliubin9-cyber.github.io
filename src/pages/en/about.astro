---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePath } from '../../lib/routing';
import { siteMeta } from '../../data/site';
import { getUiText } from '../../data/ui';

const aboutUi = getUiText('en').about;
const aboutStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About MUZI',
  description: siteMeta.description.en,
  url: new URL(localePath('en', 'about'), siteMeta.url).toString(),
  inLanguage: 'en-US',
  mainEntity: {
    '@type': 'Person',
    name: siteMeta.author.name,
    url: siteMeta.author.github
  }
};
---

<BaseLayout
  title="About MUZI"
  description={siteMeta.description.en}
  locale="en"
  switchHref={localePath('zh', 'about')}
  keywords={['about the author', 'AI infrastructure', 'cloud native', 'engineering blog']}
  structuredData={aboutStructuredData}
>
  <section class="hero">
    <span class="kicker">{aboutUi.kicker}</span>
    <h1 class="title">{aboutUi.title}</h1>
    <p class="lede">{aboutUi.lede}</p>
  </section>

  <section class="article-body">
    {aboutUi.paragraphs.map((item) => (
      <p>{item}</p>
    ))}
  </section>
</BaseLayout>
