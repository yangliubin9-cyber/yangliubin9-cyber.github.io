---
import { render } from 'astro:content';
import CommentsSection from '../../components/CommentsSection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatPublishDate,
  getPosts,
  getPostsBySeries,
  getReadingLabel,
  getSeriesNavigation,
  getTranslatedPost,
  type PostEntry
} from '../../lib/content';
import { localePath } from '../../lib/routing';
import { getSeriesBySlug, getSeriesName, siteMeta } from '../../data/site';
import { getUiText } from '../../data/ui';

export async function getStaticPaths() {
  const posts = await getPosts('en');

  return Promise.all(
    posts.map(async (post) => {
      const seriesPosts = await getPostsBySeries('en', post.data.series, 'asc');
      const { currentIndex, total, previousPost, nextPost } = getSeriesNavigation(
        seriesPosts,
        post.data.pathSlug
      );

      return {
        params: { slug: post.data.pathSlug },
        props: {
          post,
          seriesPosts,
          progressIndex: currentIndex + 1,
          totalInSeries: total,
          previousPost,
          nextPost,
          relatedPosts: seriesPosts
            .filter((item) => item.data.pathSlug !== post.data.pathSlug)
            .slice(0, 3)
        }
      };
    })
  );
}

const { post, seriesPosts, progressIndex, totalInSeries, previousPost, nextPost, relatedPosts } =
  Astro.props as {
    post: PostEntry;
    seriesPosts: PostEntry[];
    progressIndex: number;
    totalInSeries: number;
    previousPost?: PostEntry;
    nextPost?: PostEntry;
    relatedPosts: PostEntry[];
  };

const seriesItem = getSeriesBySlug(post.data.series);
const articleUi = getUiText('en').article;
const { Content, headings } = await render(post);
const alternatePost = await getTranslatedPost(post, 'zh');
const progressPercent = totalInSeries > 0 ? `${(progressIndex / totalInSeries) * 100}%` : '0%';
const articleKeywords = [...post.data.tags, ...(seriesItem ? [getSeriesName('en', seriesItem)] : [])];
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.publishedAt.toISOString(),
  inLanguage: 'en-US',
  mainEntityOfPage: new URL(localePath('en', post.data.pathSlug), siteMeta.url).toString(),
  author: {
    '@type': 'Person',
    name: siteMeta.author.name,
    url: siteMeta.author.github
  },
  publisher: {
    '@type': 'Person',
    name: siteMeta.author.name,
    url: siteMeta.author.github
  },
  keywords: articleKeywords.join(', ')
};
---

<BaseLayout
  title={`${post.data.title} | MUZI`}
  description={post.data.summary}
  locale="en"
  switchHref={alternatePost ? localePath('zh', alternatePost.data.pathSlug) : undefined}
  ogType="article"
  publishedTime={post.data.publishedAt.toISOString()}
  keywords={articleKeywords}
  structuredData={articleStructuredData}
>
  <section class="hero article-hero">
    <span class="kicker">{articleUi.kicker}</span>
    <h1 class="title article-title">{post.data.title}</h1>
    <p class="lede article-deck">{post.data.summary}</p>
    <div class="article-hero-meta" aria-label="Post information">
      {seriesItem && (
        <span class="article-hero-meta-item">{getSeriesName('en', seriesItem)}</span>
      )}
      <span class="article-hero-meta-item">{formatPublishDate('en', post.data.publishedAt)}</span>
      <span class="article-hero-meta-item">{getReadingLabel('en', post.data.readingMinutes)}</span>
    </div>
  </section>

  {seriesItem && (
    <section class="section article-overview">
      <div class="article-overview-copy">
        <span class="eyebrow">{articleUi.overviewEyebrow}</span>
        <h2>{getSeriesName('en', seriesItem)}</h2>
        <p class="muted">{articleUi.overviewProgress(progressIndex, totalInSeries)}</p>
      </div>
      <div class="article-overview-actions">
        <a class="button-link" href={localePath('en', `series/${seriesItem.slug}`)}>
          {articleUi.overviewSeriesAction}
        </a>
        <a class="button-link" href={localePath('en')}>{articleUi.overviewBackHomeAction}</a>
      </div>
    </section>
  )}

  <section class="article-layout">
    <article class="article-body article-prose">
      <Content />
    </article>

    <aside class="article-sidebar">
      {seriesItem && (
        <div class="article-sidecard">
          <span class="eyebrow">{articleUi.progressEyebrow}</span>
          <div class="series-progress-head">
            <strong>{getSeriesName('en', seriesItem)}</strong>
            <p>{articleUi.progressCount(progressIndex, totalInSeries)}</p>
          </div>
          <div class="series-progress-bar" aria-hidden="true">
            <span style={`width:${progressPercent}`}></span>
          </div>
          <nav class="series-step-list" aria-label={articleUi.progressAria}>
            {seriesPosts.map((item, index) => (
              <a
                class:list={[
                  'series-step-link',
                  { current: item.data.pathSlug === post.data.pathSlug }
                ]}
                href={localePath('en', item.data.pathSlug)}
              >
                <span>{index + 1}</span>
                <strong>{item.data.title}</strong>
              </a>
            ))}
          </nav>
        </div>
      )}

      <div class="article-sidecard">
        <span class="eyebrow">{articleUi.infoEyebrow}</span>
        <div class="meta-stack">
          <div>
            <strong>{articleUi.publishedLabel}</strong>
            <p>{formatPublishDate('en', post.data.publishedAt)}</p>
          </div>
          <div>
            <strong>{articleUi.readingTimeLabel}</strong>
            <p>{getReadingLabel('en', post.data.readingMinutes)}</p>
          </div>
          {seriesItem && (
            <div>
              <strong>{articleUi.seriesLabel}</strong>
              <p>{getSeriesName('en', seriesItem)}</p>
            </div>
          )}
        </div>
      </div>

      {headings.length > 0 && (
        <div class="article-sidecard">
          <span class="eyebrow">{articleUi.tocEyebrow}</span>
          <nav class="toc-list" aria-label={articleUi.tocAria}>
            {headings.filter((item) => item.depth <= 3).map((item) => (
              <a href={`#${item.slug}`}>{item.text}</a>
            ))}
          </nav>
        </div>
      )}

      {post.data.tags.length > 0 && (
        <div class="article-sidecard">
          <span class="eyebrow">{articleUi.tagsEyebrow}</span>
          <div class="tag-list">
            {post.data.tags.map((tag) => (
              <span class="pill">#{tag}</span>
            ))}
          </div>
        </div>
      )}
    </aside>
  </section>

  <section class="section article-pager">
    <div class="article-pager-grid">
      {previousPost ? (
        <a class="article-pager-card" href={localePath('en', previousPost.data.pathSlug)}>
          <span class="article-pager-label">{articleUi.previousLabel}</span>
          <strong>{previousPost.data.title}</strong>
          <p>{previousPost.data.summary}</p>
        </a>
      ) : (
        <div class="article-pager-card article-pager-card--muted">
          <span class="article-pager-label">{articleUi.previousLabel}</span>
          <strong>{articleUi.previousEmptyTitle}</strong>
          <p>{articleUi.previousEmptyDescription}</p>
        </div>
      )}

      {seriesItem && (
        <a class="article-pager-card article-pager-card--center" href={localePath('en', `series/${seriesItem.slug}`)}>
          <span class="article-pager-label">{articleUi.seriesOverviewLabel}</span>
          <strong>{getSeriesName('en', seriesItem)}</strong>
          <p>{articleUi.seriesOverviewDescription}</p>
        </a>
      )}

      {nextPost ? (
        <a class="article-pager-card" href={localePath('en', nextPost.data.pathSlug)}>
          <span class="article-pager-label">{articleUi.nextLabel}</span>
          <strong>{nextPost.data.title}</strong>
          <p>{nextPost.data.summary}</p>
        </a>
      ) : (
        <div class="article-pager-card article-pager-card--muted">
          <span class="article-pager-label">{articleUi.nextLabel}</span>
          <strong>{articleUi.nextEmptyTitle}</strong>
          <p>{articleUi.nextEmptyDescription}</p>
        </div>
      )}
    </div>
  </section>

  {relatedPosts.length > 0 && (
    <section class="section">
      <div class="section-header">
        <div>
          <span class="eyebrow">{articleUi.keepReadingEyebrow}</span>
          <h2>{articleUi.keepReadingTitle}</h2>
        </div>
      </div>
      <div class="grid">
        {relatedPosts.map((item) => (
          <a class="card card-post" href={localePath('en', item.data.pathSlug)}>
            <span class="pill">{getReadingLabel('en', item.data.readingMinutes)}</span>
            <h3>{item.data.title}</h3>
            <p class="muted">{item.data.summary}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <CommentsSection locale="en" threadId={post.data.pathSlug} />
</BaseLayout>
