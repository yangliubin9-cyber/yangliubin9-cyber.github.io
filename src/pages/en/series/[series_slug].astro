---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatPublishDate, getPosts, getReadingLabel, type PostEntry } from '../../../lib/content';
import { localePath } from '../../../lib/routing';
import { getSeriesDescription, getSeriesName, series, type Series } from '../../../data/site';
import { getUiText } from '../../../data/ui';

export async function getStaticPaths() {
  const posts = await getPosts('en');
  return series.map((item) => ({
    params: { series_slug: item.slug },
    props: {
      seriesItem: item,
      seriesPosts: posts.filter((post) => post.data.series === item.slug)
    }
  }));
}

const { seriesItem, seriesPosts } = Astro.props as {
  seriesItem: Series;
  seriesPosts: PostEntry[];
};

const seriesDetailUi = getUiText('en').seriesDetail;
---

<BaseLayout
  title={`${getSeriesName('en', seriesItem)} | Series`}
  description={getSeriesDescription('en', seriesItem)}
  locale="en"
  switchHref={localePath('zh', `series/${seriesItem.slug}`)}
>
  <section class="hero hero-editorial">
    <span class="kicker">{seriesDetailUi.kicker}</span>
    <h1 class="title">{getSeriesName('en', seriesItem)}</h1>
    <div class="hero-facts">
      <div class="fact-chip">
        <strong>{seriesPosts.length}</strong>
        <span>{seriesDetailUi.countLabel}</span>
      </div>
      {seriesPosts[0] && (
        <div class="fact-chip">
          <strong>{formatPublishDate('en', seriesPosts[0].data.publishedAt)}</strong>
          <span>{seriesDetailUi.latestPublishLabel}</span>
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <ul class="list">
      {seriesPosts.map((post) => (
        <li>
          <a class="list-link" href={localePath('en', post.data.pathSlug)}>
            <div class="list-head">
              <strong>{post.data.title}</strong>
              <span class="list-meta">{getReadingLabel('en', post.data.readingMinutes)}</span>
            </div>
            <p class="muted">{post.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
