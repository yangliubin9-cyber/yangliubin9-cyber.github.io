---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatPublishDate, getSeriesTracks } from '../../../lib/content';
import { localePath } from '../../../lib/routing';
import { getSeriesDescription, getSeriesName, siteMeta } from '../../../data/site';
import { getUiText } from '../../../data/ui';

const seriesTracks = await getSeriesTracks('en');
const seriesUi = getUiText('en').seriesIndex;
const startLabel = seriesUi.startLabel ?? 'Best place to start';
const latestLabel = seriesUi.latestLabel ?? 'Latest update';
const previewLabel = seriesUi.previewLabel ?? 'Reading order';
const entryAction = seriesUi.entryAction ?? 'Start here';
const overviewAction = seriesUi.overviewAction ?? 'Open series';
---

<BaseLayout
  title="Series"
  description={siteMeta.description.en}
  locale="en"
  switchHref={localePath('zh', 'series')}
>
  <section class="hero hero-editorial">
    <span class="kicker">{seriesUi.kicker}</span>
    <h1 class="title page-title">{seriesUi.title}</h1>
    <p class="lede">{seriesUi.lede}</p>
  </section>

  <section class="section">
    <div class="track-grid">
      {seriesTracks.map(({ seriesItem, posts, startPost, latestPost }) => {
        return (
          <article class="card card-track card-track-series">
            <div class="track-topline">
              <span class="pill" title={getSeriesName('en', seriesItem)}>
                {getSeriesName('en', seriesItem)}
              </span>
              <span class="track-count">{seriesUi.count(posts.length)}</span>
            </div>

            <div class="track-copy">
              <h2>{getSeriesName('en', seriesItem)}</h2>
              <p class="muted">{getSeriesDescription('en', seriesItem)}</p>
            </div>

            <div class="track-facts">
              <div class="track-fact">
                <span class="track-label">{startLabel}</span>
                <strong>{startPost.data.title}</strong>
              </div>
              <div class="track-fact">
                <span class="track-label">{latestLabel}</span>
                <strong>{latestPost.data.title}</strong>
                <p>{formatPublishDate('en', latestPost.data.publishedAt)}</p>
              </div>
            </div>

            <div class="series-preview">
              <span class="track-label">{previewLabel}</span>
              <ol>
                {posts.map((post, index) => (
                  <li>
                    <strong>{index + 1}. {post.data.title}</strong>
                  </li>
                ))}
              </ol>
            </div>

            <div class="track-actions">
              <a class="button-link primary" href={localePath('en', startPost.data.pathSlug)}>
                {entryAction}
              </a>
              <a class="button-link" href={localePath('en', `series/${seriesItem.slug}`)}>
                {overviewAction}
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
