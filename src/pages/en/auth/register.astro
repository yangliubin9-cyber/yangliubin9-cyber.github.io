---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localePath } from '../../../lib/routing';
import { siteMeta } from '../../../data/site';
---

<BaseLayout
  title="Register"
  description={siteMeta.description.en}
  locale="en"
  switchHref={localePath('zh', 'auth/register')}
  switchLabel="中文"
>
  <section class="hero">
    <span class="kicker">Auth</span>
    <h1 class="title">The register route is ready for a later email verification flow</h1>
    <p class="lede">The current step focuses on structure and deployability before real auth is added.</p>
  </section>
</BaseLayout>
