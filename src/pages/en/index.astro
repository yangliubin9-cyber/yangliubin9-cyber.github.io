---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDisplaySummary, getSeriesTracks } from '../../lib/content';
import { localePath } from '../../lib/routing';
import { getSeriesDescription, getSeriesName, isHomeFeaturedSeries, siteMeta } from '../../data/site';
import { getUiText } from '../../data/ui';

const seriesTracks = (await getSeriesTracks('en')).filter(({ seriesItem }) => isHomeFeaturedSeries(seriesItem.slug));
const homeUi = getUiText('en').home;
const trackCount = homeUi.trackCount ?? ((count: number) => `${count} posts`);
const trackLatestLabel = homeUi.trackLatestLabel ?? 'Latest update';
const trackEntryAction = homeUi.trackEntryAction ?? 'Read this entry';
const trackSeriesAction = homeUi.trackSeriesAction ?? 'View series';
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'MUZI | AI Infrastructure and Engineering Practice',
  description: siteMeta.description.en,
  url: new URL(localePath('en'), siteMeta.url).toString(),
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'WebSite',
    name: `${siteMeta.brand} | ${siteMeta.title}`,
    url: siteMeta.url
  }
};
---

<BaseLayout
  title="MUZI | AI Infrastructure and Engineering Practice"
  description={siteMeta.description.en}
  locale="en"
  switchHref={localePath('zh')}
  keywords={['AI infrastructure', 'MLOps', 'Kubernetes', 'Docker', 'engineering practice']}
  structuredData={homeStructuredData}
>
  <section class="hero hero-editorial hero-home">
    <div class="hero-copy">
      <span class="kicker">{homeUi.kicker}</span>
      <h1 class="title page-title"><span class="gradient-text">{homeUi.title}</span></h1>
      <p class="lede">{homeUi.lede}</p>
      <div class="hero-actions">
        <a class="button-link primary" href="#featured-posts">{homeUi.primaryAction}</a>
        <a class="button-link" href={localePath('en', 'about')}>{homeUi.secondaryAction}</a>
      </div>
    </div>

    <div class="hero-avatar-panel" aria-hidden="true">
      <div class="hero-avatar-frame">
        <img src="/Blog.png" alt="" loading="eager" decoding="async" />
      </div>
    </div>
  </section>

  <section class="section" id="featured-posts">
    <div class="section-header section-header-stack">
      <div>
        <span class="eyebrow">{homeUi.featuredEyebrow}</span>
        <h2>{homeUi.featuredTitle}</h2>
      </div>
      <p class="section-summary">{homeUi.featuredSummary}</p>
    </div>

    <div class="track-grid">
      {seriesTracks.map(({ seriesItem, featuredPost, latestPost, posts }) => {
        return (
          <article class="card card-track">
            <div class="track-topline">
              <span class="pill card-pill" title={getSeriesName('en', seriesItem)}>
                {getSeriesName('en', seriesItem)}
              </span>
              <span class="track-count">{trackCount(posts.length)}</span>
            </div>

            <div class="track-copy">
              <h3>{featuredPost.data.title}</h3>
              <p class="muted">{getDisplaySummary(featuredPost.data.summary, featuredPost.data.title)}</p>
              <p class="track-description">{getSeriesDescription('en', seriesItem)}</p>
            </div>

            <a class="track-link" href={localePath('en', latestPost.data.pathSlug)}>
              <span class="track-label">{trackLatestLabel}</span>
              <strong>{latestPost.data.title}</strong>
              <p>{getDisplaySummary(latestPost.data.summary, latestPost.data.title)}</p>
            </a>

            <div class="track-actions">
              <a class="button-link primary" href={localePath('en', featuredPost.data.pathSlug)}>
                {trackEntryAction}
              </a>
              <a class="button-link" href={localePath('en', `series/${seriesItem.slug}`)}>
                {trackSeriesAction}
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
