---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFeaturedPosts, getReadingLabel } from '../../lib/content';
import { localePath } from '../../lib/routing';
import { getSeriesBySlug, getSeriesName, siteMeta } from '../../data/site';
import { getUiText } from '../../data/ui';

const featuredPosts = await getFeaturedPosts('en');
const homeUi = getUiText('en').home;
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'MUZI | AI Infrastructure and Engineering Practice',
  description: siteMeta.description.en,
  url: new URL(localePath('en'), siteMeta.url).toString(),
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'WebSite',
    name: `${siteMeta.brand} | ${siteMeta.title}`,
    url: siteMeta.url
  }
};
---

<BaseLayout
  title="MUZI | AI Infrastructure and Engineering Practice"
  description={siteMeta.description.en}
  locale="en"
  switchHref={localePath('zh')}
  keywords={['AI infrastructure', 'MLOps', 'Kubernetes', 'Docker', 'engineering practice']}
  structuredData={homeStructuredData}
>
  <section class="hero hero-editorial">
    <span class="kicker">{homeUi.kicker}</span>
    <h1 class="title">{homeUi.title}</h1>
    <p class="lede">{homeUi.lede}</p>
    <div class="hero-actions">
      <a class="button-link primary" href="#featured-posts">{homeUi.primaryAction}</a>
      <a class="button-link" href={localePath('en', 'about')}>{homeUi.secondaryAction}</a>
    </div>
  </section>

  <section class="section" id="featured-posts">
    <div class="section-header">
      <div>
        <span class="eyebrow">{homeUi.featuredEyebrow}</span>
        <h2>{homeUi.featuredTitle}</h2>
      </div>
      <p class="muted">{homeUi.featuredSummary}</p>
    </div>

    <div class="grid">
      {featuredPosts.map((post) => {
        const seriesItem = getSeriesBySlug(post.data.series);
        return (
          <a class="card card-post" href={localePath('en', post.data.pathSlug)}>
            <span class="pill">
              {seriesItem ? getSeriesName('en', seriesItem) : homeUi.fallbackBadge}
            </span>
            <h3>{post.data.title}</h3>
            <p class="muted">{post.data.summary}</p>
            <strong>{getReadingLabel('en', post.data.readingMinutes)}</strong>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
