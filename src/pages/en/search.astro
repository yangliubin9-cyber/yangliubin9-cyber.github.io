---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getReadingLabel } from '../../lib/content';
import { localePath } from '../../lib/routing';
import { getSeriesBySlug, getSeriesName, series, siteMeta } from '../../data/site';
import { getUiText } from '../../data/ui';

const posts = await getPosts('en');
const searchUi = getUiText('en').search;
const searchCountTemplates = {
  all: 'Showing all {total} posts.',
  filtered: 'Showing {visible} of {total} posts.'
};
const seriesOptions = series.map((item) => ({
  slug: item.slug,
  label: getSeriesName('en', item),
  count: posts.filter((post) => post.data.series === item.slug).length
}));
---

<BaseLayout
  title="Search"
  description={siteMeta.description.en}
  locale="en"
  switchHref={localePath('zh', 'search')}
  noIndex={true}
>
  <section class="hero hero-editorial">
    <span class="kicker">{searchUi.kicker}</span>
    <h1 class="title page-title">{searchUi.title}</h1>
  </section>

  <section
    class="section search-shell"
    data-search-all-template={searchCountTemplates.all}
    data-search-filtered-template={searchCountTemplates.filtered}
  >
    <div class="search-toolbar">
      <label class="search-label" for="post-search-en">{searchUi.label}</label>
      <div class="search-input-row">
        <input
          id="post-search-en"
          class="search-input"
          type="search"
          placeholder={searchUi.placeholder}
          data-search-input
        />
        <button class="search-clear" type="button" data-search-clear disabled>{searchUi.clear}</button>
      </div>
      <div class="search-toolbar-meta">
        <p class="muted" data-search-count>{searchUi.allCount(posts.length)}</p>
      </div>
    </div>

    <div class="search-filters" aria-label={searchUi.filtersAria}>
      <button class="filter-chip is-active" type="button" data-series-filter="">
        {searchUi.allFilter}
        <span>{posts.length}</span>
      </button>
      {seriesOptions.map((item) => (
        <button class="filter-chip" type="button" data-series-filter={item.slug}>
          {item.label}
          <span>{item.count}</span>
        </button>
      ))}
    </div>

    <div class="grid search-grid" data-search-results>
      {posts.map((post) => {
        const seriesItem = getSeriesBySlug(post.data.series);
        return (
          <a
            class="card card-post"
            href={localePath('en', post.data.pathSlug)}
            data-search-item
            data-search-series={post.data.series}
            data-search-text={`${post.data.title} ${post.data.summary} ${post.data.tags.join(' ')} ${
              seriesItem ? getSeriesName('en', seriesItem) : ''
            }`.toLowerCase()}
          >
            {seriesItem && <span class="pill">{getSeriesName('en', seriesItem)}</span>}
            <h3>{post.data.title}</h3>
            <p class="muted">{post.data.summary}</p>
            <strong>{getReadingLabel('en', post.data.readingMinutes)}</strong>
          </a>
        );
      })}
    </div>

    <p class="search-empty muted" data-search-empty hidden>{searchUi.empty}</p>

    <script is:inline>
      (() => {
        const searchRoot = document.querySelector('.search-shell');
        if (!(searchRoot instanceof HTMLElement)) return;

        const input = searchRoot.querySelector('[data-search-input]');
        const clearButton = searchRoot.querySelector('[data-search-clear]');
        const count = searchRoot.querySelector('[data-search-count]');
        const allTemplate =
          searchRoot.getAttribute('data-search-all-template') ?? 'Showing all {total} posts.';
        const filteredTemplate =
          searchRoot.getAttribute('data-search-filtered-template') ??
          'Showing {visible} of {total} posts.';
        const items = Array.from(searchRoot.querySelectorAll('[data-search-item]'));
        const filters = Array.from(searchRoot.querySelectorAll('[data-series-filter]'));
        const empty = searchRoot.querySelector('[data-search-empty]');
        const total = items.length;
        let activeSeries = '';

        const formatTemplate = (template, values) =>
          Object.entries(values).reduce(
            (result, [key, value]) => result.replaceAll(`{${key}}`, String(value)),
            template
          );

        const updateActiveFilter = () => {
          filters.forEach((filter) => {
            const value = filter.getAttribute('data-series-filter') ?? '';
            filter.classList.toggle('is-active', value === activeSeries);
          });
        };

        const updateCount = (visible, hasFilter) => {
          if (!count) return;

          count.textContent = hasFilter
            ? formatTemplate(filteredTemplate, { visible, total })
            : formatTemplate(allTemplate, { total });
        };

        const applyFilter = () => {
          const query = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : '';
          const hasFilter = Boolean(query || activeSeries);
          let visible = 0;

          items.forEach((item) => {
            const text = item.getAttribute('data-search-text') ?? '';
            const itemSeries = item.getAttribute('data-search-series') ?? '';
            const matched =
              (!query || text.includes(query)) &&
              (!activeSeries || itemSeries === activeSeries);

            item.toggleAttribute('hidden', !matched);
            if (matched) visible += 1;
          });

          updateCount(visible, hasFilter);

          if (empty) {
            empty.toggleAttribute('hidden', visible !== 0);
          }

          if (clearButton instanceof HTMLButtonElement) {
            clearButton.disabled = !hasFilter;
          }
        };

        filters.forEach((filter) => {
          filter.addEventListener('click', () => {
            activeSeries = filter.getAttribute('data-series-filter') ?? '';
            updateActiveFilter();
            applyFilter();
          });
        });

        input?.addEventListener('input', applyFilter);

        clearButton?.addEventListener('click', () => {
          if (input instanceof HTMLInputElement) {
            input.value = '';
            input.focus();
          }

          activeSeries = '';
          updateActiveFilter();
          applyFilter();
        });

        updateActiveFilter();
        applyFilter();
      })();
    </script>
  </section>
</BaseLayout>
