---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import GiscusComments from '../../components/GiscusComments.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { findTranslation, formatDate, getAdjacentPosts, sortPosts } from '../../lib/posts';
import { getBlogPath, getDictionary, getLocalizedPath, getPostPath, type Locale } from '../../lib/site';

function estimateReadingMinutes(body: string, locale: Locale) {
  const normalized = body
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`[^`]*`/g, ' ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\[[^\]]*\]\([^)]+\)/g, ' ')
    .replace(/[#>*_\-\n]/g, ' ')
    .trim();
  const cjkChars = (normalized.match(/[\u3400-\u9fff]/g) || []).length;
  const latinWords = normalized.replace(/[\u3400-\u9fff]/g, ' ').split(/\s+/).filter(Boolean).length;
  const effort = locale === 'zh' ? cjkChars / 280 + latinWords / 180 : latinWords / 180 + cjkChars / 320;

  return Math.max(1, Math.ceil(effort));
}

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: {
      locale: post.data.locale,
      slug: post.data.pathSlug
    },
    props: { post }
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'posts'> };
const locale = post.data.locale as Locale;
const copy = getDictionary(locale);
const allPosts = await getCollection('posts');
const otherLocale = locale === 'zh' ? 'en' : 'zh';
const translation = findTranslation(allPosts, post.data.translationKey, otherLocale);
const relatedPosts = sortPosts(
  allPosts.filter((entry) => entry.data.locale === locale && entry.id !== post.id)
).slice(0, 2);
const adjacentPosts = getAdjacentPosts(allPosts, post);
const previousLabel = locale === 'zh' ? '上一篇' : 'Previous';
const nextLabel = locale === 'zh' ? '下一篇' : 'Next';
const { Content, headings } = await render(post);
const publishedLabel = formatDate(post.data.publishedAt, locale);
const updatedLabel = post.data.updatedAt ? formatDate(post.data.updatedAt, locale) : null;
const readingMinutes = estimateReadingMinutes(post.body, locale);
const summaryItems = [
  { label: '发布时间', value: publishedLabel },
  { label: '最近更新', value: updatedLabel ?? '首次发布' },
  { label: '预计阅读', value: `${readingMinutes} 分钟` },
  { label: '文章分类', value: post.data.category }
];
const paths = {
  zh: locale === 'zh' ? getPostPath('zh', post.data.pathSlug) : getBlogPath('zh'),
  en: locale === 'en' ? getPostPath('en', post.data.pathSlug) : getBlogPath('en')
};

if (translation) {
  paths[translation.data.locale] = getPostPath(translation.data.locale, translation.data.pathSlug);
}
---

<BaseLayout
  locale={locale}
  currentNav="blog"
  pagePath={getPostPath(locale, post.data.pathSlug)}
  paths={paths}
  title={`${post.data.title} | ${copy.branding.title}`}
  description={post.data.excerpt}
>
  {locale === 'zh' ? (
    <>
      <article class="enterprise-article">
        <section class="enterprise-article__hero panel">
          <div class="enterprise-article__hero-main">
            <a class="text-link" href={getBlogPath(locale)}>{copy.post.backToBlog}</a>
            <p class="eyebrow">{post.data.heroEyebrow ?? post.data.category}</p>
            <h1>{post.data.title}</h1>
            <p class="enterprise-article__description">{post.data.excerpt}</p>

            <div class="enterprise-meta-grid">
              {summaryItems.map((item) => (
                <article class="enterprise-meta-grid__item">
                  <span>{item.label}</span>
                  <strong>{item.value}</strong>
                </article>
              ))}
            </div>

            <div class="tag-row tag-row--wrap">
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>

          <aside class="enterprise-article__hero-aside surface">
            <p class="eyebrow">Article Overview</p>

            <div class="enterprise-summary-list">
              <div class="enterprise-summary-list__item">
                <span>路径</span>
                <strong>{`/${locale}/${post.data.pathSlug}/`}</strong>
              </div>
              <div class="enterprise-summary-list__item">
                <span>目录数量</span>
                <strong>{String(headings.length).padStart(2, '0')}</strong>
              </div>
              <div class="enterprise-summary-list__item">
                <span>语言版本</span>
                <strong>{translation ? '中英双语' : '当前仅中文'}</strong>
              </div>
            </div>

            <div class="enterprise-action-stack">
              {translation ? (
                <a class="enterprise-inline-link" href={getPostPath(translation.data.locale, translation.data.pathSlug)}>
                  <strong>查看英文版</strong>
                  <span>{translation.data.title}</span>
                </a>
              ) : null}

              <a class="enterprise-inline-link" href={getLocalizedPath(locale, 'search')}>
                <strong>打开搜索</strong>
                <span>继续检索相关主题和文章</span>
              </a>

              <a class="enterprise-inline-link" href={getBlogPath(locale)}>
                <strong>回到归档</strong>
                <span>从归档页按分类或标签继续浏览</span>
              </a>
            </div>
          </aside>
        </section>

        <div class="enterprise-article__grid">
          <div class="surface article-body article-body--enterprise" data-tilt="off">
            <Content />
          </div>

          <aside class="enterprise-article__sidebar">
            <section class="surface toc" data-tilt="off">
              <p class="eyebrow">{copy.post.contents}</p>
              {headings.length > 0 ? (
                <nav class="toc__nav">
                  {headings.map((heading) => (
                    <a href={`#${heading.slug}`} class={`toc__level toc__level--${heading.depth}`}>
                      {heading.text}
                    </a>
                  ))}
                </nav>
              ) : (
                <p class="page-intro__description">{copy.post.noContents}</p>
              )}
            </section>

            <section class="surface enterprise-sidebar-card" data-tilt="off">
              <p class="eyebrow">Reading Route</p>
              <div class="enterprise-action-stack">
                {adjacentPosts.previous ? (
                  <a class="enterprise-inline-link" href={getPostPath(locale, adjacentPosts.previous.data.pathSlug)}>
                    <strong>{previousLabel}</strong>
                    <span>{adjacentPosts.previous.data.title}</span>
                  </a>
                ) : null}

                {adjacentPosts.next ? (
                  <a class="enterprise-inline-link" href={getPostPath(locale, adjacentPosts.next.data.pathSlug)}>
                    <strong>{nextLabel}</strong>
                    <span>{adjacentPosts.next.data.title}</span>
                  </a>
                ) : null}
              </div>
            </section>
          </aside>
        </div>
      </article>

      {(adjacentPosts.previous || adjacentPosts.next) && (
        <section class="surface post-pagination post-pagination--enterprise" data-tilt="off">
          {adjacentPosts.previous ? (
            <a class="post-pagination__link" href={getPostPath(locale, adjacentPosts.previous.data.pathSlug)}>
              <span class="eyebrow">{previousLabel}</span>
              <strong>{adjacentPosts.previous.data.title}</strong>
              <span>{adjacentPosts.previous.data.excerpt}</span>
            </a>
          ) : (
            <div class="post-pagination__spacer"></div>
          )}

          {adjacentPosts.next ? (
            <a class="post-pagination__link post-pagination__link--next" href={getPostPath(locale, adjacentPosts.next.data.pathSlug)}>
              <span class="eyebrow">{nextLabel}</span>
              <strong>{adjacentPosts.next.data.title}</strong>
              <span>{adjacentPosts.next.data.excerpt}</span>
            </a>
          ) : (
            <div class="post-pagination__spacer"></div>
          )}
        </section>
      )}

      <GiscusComments locale={locale} />

      {relatedPosts.length > 0 && (
        <section class="section">
          <div class="section-heading">
            <p class="eyebrow">Further Reading</p>
            <h2>{copy.post.related}</h2>
            <p>继续从同一主题域扩展阅读，保持稳定的阅读路径。</p>
          </div>
          <div class="posts-grid">
            {relatedPosts.map((entry) => <PostCard post={entry} locale={locale} />)}
          </div>
        </section>
      )}
    </>
  ) : (
    <>
      <article class="article-layout">
        <section class="article-hero panel">
          <a class="text-link" href={getBlogPath(locale)}>{copy.post.backToBlog}</a>
          <p class="eyebrow">{post.data.heroEyebrow ?? post.data.category}</p>
          <h1>{post.data.title}</h1>
          <p class="page-intro__description">{post.data.excerpt}</p>

          <div class="article-meta">
            <span>{copy.post.published}: {publishedLabel}</span>
            <span>{copy.post.category}: {post.data.category}</span>
            {post.data.updatedAt && <span>{copy.post.updated}: {updatedLabel}</span>}
          </div>

          <div class="tag-row tag-row--wrap">
            {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </section>

        <div class="article-grid">
          <div class="surface article-body" data-tilt="off">
            <Content />
          </div>

          <aside class="surface toc" data-tilt="off">
            <p class="eyebrow">{copy.post.contents}</p>
            {headings.length > 0 ? (
              <nav class="toc__nav">
                {headings.map((heading) => (
                  <a href={`#${heading.slug}`} class={`toc__level toc__level--${heading.depth}`}>
                    {heading.text}
                  </a>
                ))}
              </nav>
            ) : (
              <p class="page-intro__description">{copy.post.noContents}</p>
            )}
          </aside>
        </div>
      </article>

      {(adjacentPosts.previous || adjacentPosts.next) && (
        <section class="surface post-pagination" data-tilt="off">
          {adjacentPosts.previous ? (
            <a class="post-pagination__link" href={getPostPath(locale, adjacentPosts.previous.data.pathSlug)}>
              <span class="eyebrow">{previousLabel}</span>
              <strong>{adjacentPosts.previous.data.title}</strong>
              <span>{adjacentPosts.previous.data.excerpt}</span>
            </a>
          ) : (
            <div class="post-pagination__spacer"></div>
          )}

          {adjacentPosts.next ? (
            <a class="post-pagination__link post-pagination__link--next" href={getPostPath(locale, adjacentPosts.next.data.pathSlug)}>
              <span class="eyebrow">{nextLabel}</span>
              <strong>{adjacentPosts.next.data.title}</strong>
              <span>{adjacentPosts.next.data.excerpt}</span>
            </a>
          ) : (
            <div class="post-pagination__spacer"></div>
          )}
        </section>
      )}

      <GiscusComments locale={locale} />

      {relatedPosts.length > 0 && (
        <section class="section">
          <div class="section-heading">
            <p class="eyebrow">BLOG / MORE</p>
            <h2>{copy.post.related}</h2>
          </div>
          <div class="posts-grid">
            {relatedPosts.map((entry) => <PostCard post={entry} locale={locale} />)}
          </div>
        </section>
      )}
    </>
  )}
</BaseLayout>
