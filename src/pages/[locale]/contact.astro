---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, SITE, getDictionary, getLanguagePaths, getLocalizedPath, type Locale } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const paths = getLanguagePaths('contact');
const contactCopy = locale === 'zh'
  ? {
      emailAction: '发送邮件',
      windowEyebrow: 'Contact Window',
      windowTitle: '联系入口保持尽量简单，邮箱优先。',
      windowBody: '这一页不再堆叠过多模块，只保留清晰的沟通入口。GitHub 作为补充链接存在，正式沟通以邮箱为主。',
      notes: [
        '适合讨论博客、前端实现、自动化工作流和云上工程。',
        '如果需要更完整的上下文，邮件通常是最稳定的方式。'
      ],
      emailEyebrow: 'Email',
      emailTitle: '主要联系邮箱'
    }
  : {
      emailAction: 'Send email',
      windowEyebrow: 'Contact Window',
      windowTitle: 'The contact layer stays minimal, with email as the primary channel.',
      windowBody: 'This page intentionally removes extra modules and keeps only the clearest communication path. GitHub remains as a lightweight secondary link.',
      notes: [
        'Best for conversations about the blog, frontend implementation, automation workflows, and cloud systems.',
        'For anything that needs more context, email is the most reliable route.'
      ],
      emailEyebrow: 'Email',
      emailTitle: 'Primary contact address'
    };
---

<BaseLayout
  locale={locale}
  currentNav="contact"
  pagePath={getLocalizedPath(locale, 'contact')}
  paths={paths}
  title={`${copy.nav.contact} | ${copy.branding.title}`}
  description={copy.contact.description}
>
  <PageIntro eyebrow={copy.contact.eyebrow} title={copy.contact.title} description={copy.contact.description}>
    <div class="page-intro__actions">
      <a
        class="folio-icon-link"
        href={SITE.profileUrl}
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 1.5A10.5 10.5 0 0 0 8.68 21.97c.53.1.72-.23.72-.52v-1.84c-2.92.64-3.53-1.24-3.53-1.24-.48-1.2-1.16-1.52-1.16-1.52-.95-.64.07-.63.07-.63 1.05.08 1.6 1.08 1.6 1.08.94 1.6 2.46 1.14 3.06.88.1-.68.36-1.14.66-1.4-2.33-.26-4.78-1.16-4.78-5.18 0-1.14.4-2.06 1.08-2.79-.11-.26-.47-1.32.1-2.74 0 0 .88-.28 2.88 1.06a9.96 9.96 0 0 1 5.24 0c2-1.34 2.88-1.06 2.88-1.06.57 1.42.21 2.48.1 2.74.67.73 1.08 1.65 1.08 2.79 0 4.03-2.46 4.91-4.8 5.17.38.33.72.96.72 1.94v2.87c0 .29.19.63.73.52A10.5 10.5 0 0 0 12 1.5Z"
          />
        </svg>
      </a>
      <a class="button button--ghost" href={`mailto:${SITE.email}`}>{contactCopy.emailAction}</a>
    </div>
  </PageIntro>

  <section class="section folio-contact-shell">
    <article class="surface folio-contact-main">
      <p class="eyebrow">{contactCopy.windowEyebrow}</p>
      <h2>{contactCopy.windowTitle}</h2>
      <p>{contactCopy.windowBody}</p>
      <div class="folio-check-list">
        {contactCopy.notes.map((item) => <p>{item}</p>)}
      </div>
    </article>

    <article class="surface folio-contact-email">
      <p class="eyebrow">{contactCopy.emailEyebrow}</p>
      <h2>{contactCopy.emailTitle}</h2>
      <a class="text-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </article>
  </section>
</BaseLayout>
