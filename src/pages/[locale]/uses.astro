---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, getDictionary, getLanguagePaths, getLocalizedPath, type Locale } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const paths = getLanguagePaths('uses');
const stackCopy = locale === 'zh'
  ? {
      noteEyebrow: 'Technical Direction',
      noteTitle: '技术页更像一份工作说明，而不是装备清单。',
      noteBody: '我更关心哪些工具真的帮助表达、交付和长期维护，因此这里保留的是方法和栈，而不是堆砌参数。'
    }
  : {
      noteEyebrow: 'Technical Direction',
      noteTitle: 'This page reads more like a working stack note than a gear checklist.',
      noteBody: 'The emphasis stays on tools and preferences that actually improve expression, delivery, and long-term maintenance.'
    };
---

<BaseLayout
  locale={locale}
  currentNav="uses"
  pagePath={getLocalizedPath(locale, 'uses')}
  paths={paths}
  title={`${copy.nav.uses} | ${copy.branding.title}`}
  description={copy.uses.description}
>
  <PageIntro eyebrow={copy.uses.eyebrow} title={copy.uses.title} description={copy.uses.description} />

  <section class="section">
    <div class="folio-uses-grid">
      {copy.uses.groups.map((group) => (
        <article class="surface folio-uses-card">
          <p class="eyebrow">{group.name}</p>
          <div class="folio-check-list">
            {group.items.map((item) => <p>{item}</p>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="surface folio-uses-note">
    <div class="folio-uses-note__copy">
      <p class="eyebrow">{stackCopy.noteEyebrow}</p>
      <h2>{stackCopy.noteTitle}</h2>
      <p>{stackCopy.noteBody}</p>
    </div>
  </section>
</BaseLayout>
