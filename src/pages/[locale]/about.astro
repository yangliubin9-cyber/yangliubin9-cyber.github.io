---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROFILE, SITE, LOCALES, getDictionary, getLanguagePaths, getLocalizedPath, type Locale } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const paths = getLanguagePaths('about');
const aboutCopy = locale === 'zh'
  ? {
      emailAction: '发送邮件',
      profileEyebrow: 'Profile',
      signals: ['全栈开发', '界面表达', '云计算运维', '技术写作'],
      metrics: [
        { label: 'Focus', value: 'Build + Design' },
        { label: 'Approach', value: 'Calm Systems' }
      ],
      summaryEyebrow: 'Working Style',
      summaryTitle: '我更关注稳定表达，而不是短期堆叠功能。',
      summaryItems: [
        '把开发、设计和部署串成一条连续的交付链路。',
        '尽量用更少的界面噪音，换更清楚的信息结构。',
        '重视长期维护，尤其是静态内容系统与自动化流程。'
      ]
    }
  : {
      emailAction: 'Send email',
      profileEyebrow: 'Profile',
      signals: ['Full-stack', 'Interface craft', 'Cloud operations', 'Technical writing'],
      metrics: [
        { label: 'Focus', value: 'Build + Design' },
        { label: 'Approach', value: 'Calm Systems' }
      ],
      summaryEyebrow: 'Working Style',
      summaryTitle: 'I care more about clarity, continuity, and maintainable systems than visual noise.',
      summaryItems: [
        'Connect design, engineering, and delivery into one readable workflow.',
        'Reduce interface friction so the information architecture carries the experience.',
        'Favor long-term maintainability, especially for static content systems and automation.'
      ]
    };
---

<BaseLayout
  locale={locale}
  currentNav="about"
  pagePath={getLocalizedPath(locale, 'about')}
  paths={paths}
  title={`${copy.nav.about} | ${copy.branding.title}`}
  description={copy.about.description}
>
  <PageIntro eyebrow={copy.about.eyebrow} title={copy.about.title} description={copy.about.description}>
    <div class="page-intro__actions">
      <a class="button button--ghost" href={SITE.profileUrl} target="_blank" rel="noreferrer">GitHub</a>
      <a class="text-link" href={`mailto:${SITE.email}`}>{aboutCopy.emailAction}</a>
    </div>
  </PageIntro>

  <section class="section folio-about-shell">
    <article class="surface folio-about-profile">
      <div class="folio-about-profile__header">
        <p class="eyebrow">{aboutCopy.profileEyebrow}</p>
        <img
          class="folio-about-profile__avatar"
          src={PROFILE.avatar}
          alt={PROFILE.name[locale]}
          loading="lazy"
          onerror={`this.onerror=null;this.src='${PROFILE.avatarFallback}'`}
        />
        <div class="folio-about-profile__body">
          <h2>{PROFILE.name[locale]}</h2>
          <p>{PROFILE.tagline[locale]}</p>
        </div>
      </div>

      <div class="folio-about-profile__signals">
        {aboutCopy.signals.map((item) => <span class="tag">{item}</span>)}
      </div>

      <div class="folio-about-profile__metrics">
        {aboutCopy.metrics.map((item) => (
          <div class="folio-stat-card">
            <span>{item.label}</span>
            <strong>{item.value}</strong>
          </div>
        ))}
      </div>
    </article>

    <div class="folio-about-grid">
      <article class="surface folio-about-card folio-about-card--wide">
        <p class="eyebrow">{aboutCopy.summaryEyebrow}</p>
        <h2>{aboutCopy.summaryTitle}</h2>
        <div class="folio-check-list">
          {aboutCopy.summaryItems.map((item) => <p>{item}</p>)}
        </div>
      </article>

      <article class="surface folio-about-card">
        <p class="eyebrow">{copy.about.sections.background}</p>
        <div class="folio-check-list">
          {copy.about.background.map((item) => <p>{item}</p>)}
        </div>
      </article>

      <article class="surface folio-about-card">
        <p class="eyebrow">{copy.about.sections.skills}</p>
        <div class="tag-row tag-row--wrap">
          {copy.about.skills.map((item) => <span class="tag">{item}</span>)}
        </div>
      </article>

      <article class="surface folio-about-card">
        <p class="eyebrow">{copy.about.sections.interests}</p>
        <div class="tag-row tag-row--wrap">
          {copy.about.interests.map((item) => <span class="tag">{item}</span>)}
        </div>
      </article>

      <article class="surface folio-about-card">
        <p class="eyebrow">{copy.about.sections.contact}</p>
        <div class="folio-check-list">
          <p><a class="text-link" href={SITE.profileUrl} target="_blank" rel="noreferrer">GitHub</a></p>
          <p><a class="text-link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
