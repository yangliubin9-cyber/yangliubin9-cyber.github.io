---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROFILE, SITE, LOCALES, getDictionary, getLanguagePaths, getLocalizedPath, type Locale } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const paths = getLanguagePaths('about');
const aboutCopy = locale === 'zh'
  ? {
      emailAction: '发送邮件',
      profileEyebrow: 'Profile',
      summary:
        '我主要关注前端表达、工程交付和云上运维之间的连接方式，尽量把复杂系统整理成清楚、稳定、可长期维护的体验。',
      signals: [
        { label: 'Focus', value: 'Frontend / Astro / React' },
        { label: 'Ops', value: 'Cloud / Automation' },
        { label: 'Writing', value: 'Technical notes' }
      ],
      noteEyebrow: 'Working Style',
      noteTitle: '工作方式',
      noteItems: [
        '先整理结构，再处理视觉和交互。',
        '重视交付链路的稳定性，而不是短期堆叠功能。',
        '喜欢信息密度高但阅读负担低的页面。'
      ],
      linkGithub: 'GitHub',
      linkEmail: '邮箱'
    }
  : {
      emailAction: 'Send email',
      profileEyebrow: 'Profile',
      summary:
        'I work across frontend craft, engineering delivery, and cloud operations, with a preference for turning complex systems into clear and durable experiences.',
      signals: [
        { label: 'Focus', value: 'Frontend / Astro / React' },
        { label: 'Ops', value: 'Cloud / Automation' },
        { label: 'Writing', value: 'Technical notes' }
      ],
      noteEyebrow: 'Working Style',
      noteTitle: 'How I work',
      noteItems: [
        'Structure comes first, then visual refinement and interaction.',
        'Stable delivery matters more than short-term feature stacking.',
        'I prefer interfaces with high information density but low reading friction.'
      ],
      linkGithub: 'GitHub',
      linkEmail: 'Email'
    };
---

<BaseLayout
  locale={locale}
  currentNav="about"
  pagePath={getLocalizedPath(locale, 'about')}
  paths={paths}
  title={`${copy.nav.about} | ${copy.branding.title}`}
  description={copy.about.description}
>
  <PageIntro eyebrow={copy.about.eyebrow} title={copy.about.title} description={copy.about.description}>
    <div class="page-intro__actions">
      <a class="button button--ghost" href={SITE.profileUrl} target="_blank" rel="noreferrer">GitHub</a>
      <a class="text-link" href={`mailto:${SITE.email}`}>{aboutCopy.emailAction}</a>
    </div>
  </PageIntro>

  <section class="section folio-about-shell">
    <article class="surface folio-about-profile">
      <div class="folio-about-profile__hero">
        <img
          class="folio-about-profile__avatar"
          src={PROFILE.avatar}
          alt={PROFILE.name[locale]}
          loading="lazy"
          onerror={`this.onerror=null;this.src='${PROFILE.avatarFallback}'`}
        />

        <div class="folio-about-profile__identity">
          <p class="eyebrow">{aboutCopy.profileEyebrow}</p>
          <h2>{PROFILE.name[locale]}</h2>
          <p>{PROFILE.tagline[locale]}</p>
        </div>
      </div>

      <p class="folio-about-profile__summary">{aboutCopy.summary}</p>

      <div class="folio-about-profile__signal-list">
        {aboutCopy.signals.map((item) => (
          <div class="folio-profile-line">
            <span>{item.label}</span>
            <strong>{item.value}</strong>
          </div>
        ))}
      </div>

      <div class="folio-about-profile__links">
        <a class="text-link" href={SITE.profileUrl} target="_blank" rel="noreferrer">{aboutCopy.linkGithub}</a>
        <a class="text-link" href={`mailto:${SITE.email}`}>{aboutCopy.linkEmail}</a>
      </div>
    </article>

    <div class="folio-about-grid">
      <article class="surface folio-about-card">
        <p class="eyebrow">{copy.about.sections.background}</p>
        <div class="folio-check-list">
          {copy.about.background.map((item) => <p>{item}</p>)}
        </div>
      </article>

      <article class="surface folio-about-card">
        <p class="eyebrow">{aboutCopy.noteEyebrow}</p>
        <h2>{aboutCopy.noteTitle}</h2>
        <div class="folio-check-list">
          {aboutCopy.noteItems.map((item) => <p>{item}</p>)}
        </div>
      </article>

      <article class="surface folio-about-card">
        <p class="eyebrow">{copy.about.sections.skills}</p>
        <div class="tag-row tag-row--wrap">
          {copy.about.skills.map((item) => <span class="tag">{item}</span>)}
        </div>
      </article>

      <article class="surface folio-about-card">
        <p class="eyebrow">{copy.about.sections.interests}</p>
        <div class="tag-row tag-row--wrap">
          {copy.about.interests.map((item) => <span class="tag">{item}</span>)}
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
