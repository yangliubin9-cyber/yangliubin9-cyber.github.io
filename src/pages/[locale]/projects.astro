---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, SITE, getBlogPath, getDictionary, getLanguagePaths, getLocalizedPath, type Locale } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const paths = getLanguagePaths('projects');
const projectCards = locale === 'zh'
  ? [
      {
        title: '代码仓库',
        description: '集中维护个人技术项目与自动化脚本，持续迭代工程实践、部署流程与可复用能力组件。',
        status: '维护中',
        action: '查看项目',
        href: SITE.repositoryUrl
      },
      {
        title: "Yang's 博客",
        description: '双语博客系统，支持 MDX、主题切换、全文搜索与 GitHub Pages 自动部署。',
        status: '维护中',
        action: '查看项目',
        href: getBlogPath(locale)
      }
    ]
  : [
      {
        title: 'Code Repository',
        description: 'A maintained collection of personal engineering work, automation scripts, and reusable delivery experiments.',
        status: 'Active',
        action: 'View project',
        href: SITE.repositoryUrl
      },
      {
        title: "Yang's Blog",
        description: 'A bilingual blog system with MDX, theme switching, search, and GitHub Pages deployment.',
        status: 'Active',
        action: 'View project',
        href: getBlogPath(locale)
      }
    ];
---

<BaseLayout
  locale={locale}
  currentNav="projects"
  pagePath={getLocalizedPath(locale, 'projects')}
  paths={paths}
  title={`${copy.nav.projects} | ${copy.branding.title}`}
  description={copy.projects.description}
>
  <PageIntro eyebrow={copy.projects.eyebrow} title={copy.projects.title} description={copy.projects.description} />

  <section class="section ref-projects-grid">
    {projectCards.map((item) => (
      <article class="surface ref-project-card">
        <div class="ref-project-card__top">
          <h2>{item.title}</h2>
          <span class="pill">{item.status}</span>
        </div>

        <p>{item.description}</p>

        <a
          class="text-link"
          href={item.href}
          target={item.href.startsWith('http') ? '_blank' : undefined}
          rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
        >
          {item.action}
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
