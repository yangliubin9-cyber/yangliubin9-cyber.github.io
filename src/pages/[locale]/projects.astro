---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, getBlogPath, getDictionary, getLanguagePaths, getLocalizedPath, type Locale } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const paths = getLanguagePaths('projects');
const projectCards = locale === 'zh'
  ? [
      {
        title: '写作工作流',
        description: '围绕双语写作、内容整理与发布构建的内部工作流，用来保证博客的长期维护与稳定交付。',
        status: '内部维护',
        action: '打开工作台',
        href: getLocalizedPath(locale, 'studio')
      },
      {
        title: "Yang's 博客",
        description: '面向读者的双语博客归档与文章阅读入口，持续发布技术、工程与生活观察。',
        status: '在线',
        action: '进入博客',
        href: getBlogPath(locale)
      }
    ]
  : [
      {
        title: 'Publishing Workflow',
        description: 'An internal writing and publishing workflow for bilingual drafts, editorial cleanup, and steady long-term maintenance.',
        status: 'Internal',
        action: 'Open studio',
        href: getLocalizedPath(locale, 'studio')
      },
      {
        title: "Yang's Blog",
        description: 'The reader-facing bilingual archive where technical notes, engineering practice, and life observations are published over time.',
        status: 'Live',
        action: 'Open blog',
        href: getBlogPath(locale)
      }
    ];
---

<BaseLayout
  locale={locale}
  currentNav="projects"
  pagePath={getLocalizedPath(locale, 'projects')}
  paths={paths}
  title={`${copy.nav.projects} | ${copy.branding.title}`}
  description={copy.projects.description}
>
  <PageIntro eyebrow={copy.projects.eyebrow} title={copy.projects.title} description={copy.projects.description} />

  <section class="section ref-projects-grid">
    {projectCards.map((item) => (
      <article class="surface ref-project-card">
        <div class="ref-project-card__top">
          <h2>{item.title}</h2>
          <span class="pill">{item.status}</span>
        </div>

        <p>{item.description}</p>

        <a
          class="text-link"
          href={item.href}
          target={item.href.startsWith('http') ? '_blank' : undefined}
          rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
        >
          {item.action}
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
