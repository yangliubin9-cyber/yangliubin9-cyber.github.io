---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDate, getAllPosts, getCategories, getTags } from '../../../lib/posts';
import { LOCALES, getBlogPath, getDictionary, getLanguagePaths, getLocalizedPath, getPostPath, type Locale } from '../../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
    props: { locale }
  }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const posts = await getAllPosts();
const localizedPosts = posts.filter((post) => post.data.locale === locale);
const blogPosts = localizedPosts;
const categories = getCategories(blogPosts);
const tags = getTags(blogPosts);
const paths = getLanguagePaths('blog');
const resultLabel = copy.blog.resultLabel;
const blogCopy = locale === 'zh'
  ? {
      eyebrow: 'Blog Archive',
      description: '保留分类、标签和按发布时间排序的文章列表，减少无关入口，让归档页更像一个稳定的内容目录。',
      noteEyebrow: 'Reading Mode',
      noteBody: '文章默认按发布时间倒序排列，筛选结果会即时更新，不改动现有内容系统。',
      listEyebrow: 'Recent Posts',
      listTitle: '最近发布',
      listDescription: '按时间线查看更新，并通过分类与标签快速收束范围。',
      homeAction: '返回首页',
      readAction: '阅读全文'
    }
  : {
      eyebrow: 'Blog Archive',
      description: 'The index keeps only the essentials: category, tag, and a reverse-chronological list of posts.',
      noteEyebrow: 'Reading Mode',
      noteBody: 'Results update instantly as filters change while the underlying content system stays untouched.',
      listEyebrow: 'Recent Posts',
      listTitle: 'Recent posts',
      listDescription: 'Browse the latest writing in publish order and narrow the list by category or tag.',
      homeAction: 'Back to home',
      readAction: 'Read post'
    };
const filterScript = `(() => {
  const root = document.querySelector('[data-blog-filters]');
  if (!root) return;

  const cards = [...root.querySelectorAll('[data-post-card]')];
  const categoryButtons = [...root.querySelectorAll('[data-category-filter]')];
  const tagButtons = [...root.querySelectorAll('[data-tag-filter]')];
  const count = root.querySelector('[data-results-count]');
  const empty = root.querySelector('[data-empty-state]');
  const params = new URLSearchParams(window.location.search);
  const state = {
    category: params.get('category') || 'all',
    tag: params.get('tag') || 'all'
  };

  const syncButtons = (buttons, value, key) => {
    buttons.forEach((button) => {
      const active = button.dataset[key] === value;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  };

  const apply = () => {
    let visible = 0;

    cards.forEach((card) => {
      const matchesCategory = state.category === 'all' || card.dataset.category === state.category;
      const matchesTag = state.tag === 'all' || (card.dataset.tags || '').split('|').includes(state.tag);
      const show = matchesCategory && matchesTag;
      card.hidden = !show;
      if (show) visible += 1;
    });

    if (count) count.textContent = visible + ' ' + ${JSON.stringify(resultLabel)};
    if (empty) empty.hidden = visible !== 0;

    const nextParams = new URLSearchParams();
    if (state.category !== 'all') nextParams.set('category', state.category);
    if (state.tag !== 'all') nextParams.set('tag', state.tag);
    const nextValue = nextParams.toString();
    history.replaceState({}, '', nextValue ? window.location.pathname + '?' + nextValue : window.location.pathname);

    syncButtons(categoryButtons, state.category, 'categoryFilter');
    syncButtons(tagButtons, state.tag, 'tagFilter');
  };

  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      state.category = button.dataset.categoryFilter || 'all';
      apply();
    });
  });

  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      state.tag = button.dataset.tagFilter || 'all';
      apply();
    });
  });

  apply();
})();`;
---

<BaseLayout
  locale={locale}
  currentNav="blog"
  pagePath={getBlogPath(locale)}
  paths={paths}
  title={`${copy.nav.blog} | ${copy.branding.title}`}
  description={copy.blog.description}
>
  <section class="folio-blog-head panel">
    <div class="folio-blog-head__copy">
      <p class="eyebrow">{blogCopy.eyebrow}</p>
      <h1>{copy.blog.title}</h1>
      <p class="folio-blog-head__description">{blogCopy.description}</p>
    </div>

    <aside class="surface folio-blog-head__note">
      <p class="eyebrow">{blogCopy.noteEyebrow}</p>
      <p>{blogCopy.noteBody}</p>
    </aside>
  </section>

  <section class="section folio-blog-shell" data-blog-filters>
    <div class="surface folio-blog-filter-card">
      <div class="filter-group">
        <span>{copy.blog.categoryLabel}</span>
        <div class="chip-group">
          <button type="button" class="filter-chip is-active" data-category-filter="all" aria-pressed="true">
            {copy.blog.allCategories}
          </button>
          {categories.map((category) => (
            <button type="button" class="filter-chip" data-category-filter={category} aria-pressed="false">
              {category}
            </button>
          ))}
        </div>
      </div>

      <div class="filter-group">
        <span>{copy.blog.tagLabel}</span>
        <div class="chip-group">
          <button type="button" class="filter-chip is-active" data-tag-filter="all" aria-pressed="true">
            {copy.blog.allTags}
          </button>
          {tags.map((tag) => (
            <button type="button" class="filter-chip" data-tag-filter={tag} aria-pressed="false">
              {tag}
            </button>
          ))}
        </div>
      </div>

      <p class="filter-panel__count" data-results-count>{`${blogPosts.length} ${copy.blog.resultLabel}`}</p>
    </div>

    <div class="section-heading section-heading--with-action">
      <div>
        <p class="eyebrow">{blogCopy.listEyebrow}</p>
        <h2>{blogCopy.listTitle}</h2>
        <p>{blogCopy.listDescription}</p>
      </div>

      <a class="text-link" href={getLocalizedPath(locale)}>{blogCopy.homeAction}</a>
    </div>

    <div class="folio-blog-list">
      {blogPosts.map((post) => (
        <article
          class="surface folio-blog-item"
          data-post-card
          data-category={post.data.category}
          data-tags={post.data.tags.join('|')}
        >
          <div class="folio-blog-item__meta">
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, locale)}</time>
            <span class="pill">{post.data.category}</span>
          </div>

          <div class="folio-blog-item__body">
            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
          </div>

          <div class="folio-blog-item__footer">
            <div class="tag-row tag-row--wrap">
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <a class="text-link" href={getPostPath(post.data.locale, post.data.pathSlug)}>{blogCopy.readAction}</a>
          </div>
        </article>
      ))}
    </div>

    <div class="surface empty-state" data-empty-state hidden>
      <h2>{copy.blog.emptyTitle}</h2>
      <p>{copy.blog.emptyBody}</p>
    </div>
  </section>

  <script is:inline set:html={filterScript}></script>
</BaseLayout>
