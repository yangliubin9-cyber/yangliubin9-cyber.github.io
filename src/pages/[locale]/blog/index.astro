---
import PageIntro from '../../../components/PageIntro.astro';
import PostCard from '../../../components/PostCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDate, getAllPosts, getCategories, getTags } from '../../../lib/posts';
import { LOCALES, SITE, getBlogPath, getDictionary, getLanguagePaths, getLocalizedPath, getPostPath, type Locale } from '../../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
    props: { locale }
  }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const posts = await getAllPosts();
const localizedPosts = posts.filter((post) => post.data.locale === locale);
const categories = getCategories(posts);
const tags = getTags(posts);
const paths = getLanguagePaths('blog');
const resultLabel = copy.blog.resultLabel;
const leadStory = localizedPosts[0] ?? posts[0] ?? null;
const briefingPosts = localizedPosts.slice(1, 4);
const localizedCategories = getCategories(localizedPosts);
const localeBreakdown = [
  { label: copy.localeLabel.zh, value: posts.filter((post) => post.data.locale === 'zh').length },
  { label: copy.localeLabel.en, value: posts.filter((post) => post.data.locale === 'en').length }
];
const catalogMetrics = [
  {
    label: locale === 'zh' ? '文章总数' : 'Total posts',
    value: String(posts.length).padStart(2, '0')
  },
  {
    label: locale === 'zh' ? '分类数' : 'Categories',
    value: String(categories.length).padStart(2, '0')
  },
  {
    label: locale === 'zh' ? '标签数' : 'Tags',
    value: String(tags.length).padStart(2, '0')
  }
];
const catalogTitle = locale === 'zh' ? '内容索引' : 'Catalog overview';
const catalogDescription = locale === 'zh'
  ? '这是一份持续更新的写作索引，支持跨语言浏览、按分类聚焦，以及按标签回溯主题。'
  : 'A living writing index designed for cross-locale browsing, focused category scans, and tag-based recall.';
const catalogNotes = locale === 'zh'
  ? [
      '先用搜索框缩小范围，再切换分类或标签，阅读路径会更稳定。',
      '筛选状态会同步到 URL，适合直接分享给别人。',
      '当前列表同时覆盖中英文文章，不需要分站切换。'
    ]
  : [
      'Start with search, then tighten by category or tag for a cleaner reading path.',
      'The current filter state is mirrored into the URL for easy sharing.',
      'This index spans both Chinese and English posts without splitting the site.'
    ];
const archivePrompts = locale === 'zh'
  ? [
      '先读精选，再进入完整归档，会比直接扫所有卡片更清楚。',
      '中文页优先展示中文文章，但索引和筛选仍保持跨语言统一。',
      '搜索、分类与标签仍然会实时写入 URL，方便复用和分享。'
    ]
  : [
      'Start with the curated notes, then move into the full archive.',
      'The archive still supports bilingual filtering and URL-based state.',
      'This page remains a practical reading desk rather than a marketing surface.'
    ];
const filterScript = `(() => {
  const root = document.querySelector('[data-blog-filters]');
  if (!root) return;

  const cards = [...root.querySelectorAll('[data-post-card]')];
  const searchInput = root.querySelector('[data-search-input]');
  const categoryButtons = [...root.querySelectorAll('[data-category-filter]')];
  const tagButtons = [...root.querySelectorAll('[data-tag-filter]')];
  const count = root.querySelector('[data-results-count]');
  const empty = root.querySelector('[data-empty-state]');
  const params = new URLSearchParams(window.location.search);
  const state = {
    query: params.get('q') || '',
    category: params.get('category') || 'all',
    tag: params.get('tag') || 'all'
  };

  const syncButtons = (buttons, value, key) => {
    buttons.forEach((button) => {
      const active = button.dataset[key] === value;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  };

  const apply = () => {
    const query = state.query.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const matchesQuery = !query || (card.dataset.searchText || '').includes(query);
      const matchesCategory = state.category === 'all' || card.dataset.category === state.category;
      const matchesTag = state.tag === 'all' || (card.dataset.tags || '').split('|').includes(state.tag);
      const show = matchesQuery && matchesCategory && matchesTag;
      card.hidden = !show;
      if (show) visible += 1;
    });

    if (count) count.textContent = visible + ' ' + ${JSON.stringify(resultLabel)};
    if (empty) empty.hidden = visible !== 0;

    const nextParams = new URLSearchParams();
    if (state.query) nextParams.set('q', state.query);
    if (state.category !== 'all') nextParams.set('category', state.category);
    if (state.tag !== 'all') nextParams.set('tag', state.tag);
    const nextValue = nextParams.toString();
    history.replaceState({}, '', nextValue ? window.location.pathname + '?' + nextValue : window.location.pathname);
    syncButtons(categoryButtons, state.category, 'categoryFilter');
    syncButtons(tagButtons, state.tag, 'tagFilter');
  };

  if (searchInput) {
    searchInput.value = state.query;
    searchInput.addEventListener('input', (event) => {
      state.query = event.target.value;
      apply();
    });
  }

  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      state.category = button.dataset.categoryFilter || 'all';
      apply();
    });
  });

  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      state.tag = button.dataset.tagFilter || 'all';
      apply();
    });
  });

  apply();
})();`;
---

<BaseLayout
  locale={locale}
  currentNav="blog"
  pagePath={getBlogPath(locale)}
  paths={paths}
  title={`${copy.nav.blog} | ${copy.branding.title}`}
  description={copy.blog.description}
>
  {locale === 'zh' ? (
    <>
      <section class="blog-zh-intro panel">
        <div class="blog-zh-intro__masthead">
          <p class="eyebrow">Archive / Technical Publication</p>
          <span class="blog-zh-intro__issue">技术归档 / 中文目录</span>
        </div>

        <div class="blog-zh-intro__grid">
          <div class="blog-zh-intro__copy">
            <p class="blog-zh-intro__label">Reading Desk</p>
            <h1>这是一份给长期阅读准备的技术文章目录。</h1>
            <p class="blog-zh-intro__dek">
              它不追求像内容平台那样不停推荐，而更像一张持续更新的归档桌面。先建立主题感，再通过搜索、分类和标签进入具体文章。
            </p>

            <div class="hero__actions">
              <a class="button" href={getLocalizedPath(locale, 'search')}>搜索文章</a>
              <a class="button button--ghost" href={getLocalizedPath(locale)}>返回首页</a>
            </div>
          </div>

          <aside class="blog-zh-intro__aside surface">
            <p class="eyebrow">Archive Notes</p>

            <div class="metrics-grid">
              <article class="metric-card">
                <span>中文文章</span>
                <strong>{String(localizedPosts.length).padStart(2, '0')}</strong>
              </article>
              <article class="metric-card">
                <span>专题分类</span>
                <strong>{String(localizedCategories.length).padStart(2, '0')}</strong>
              </article>
              <article class="metric-card">
                <span>全部归档</span>
                <strong>{String(posts.length).padStart(2, '0')}</strong>
              </article>
            </div>

            <div class="tag-row tag-row--wrap">
              {localizedCategories.slice(0, 5).map((item) => <span class="tag">{item}</span>)}
            </div>

            <div class="note-list">
              {archivePrompts.map((item) => <p>{item}</p>)}
            </div>
          </aside>
        </div>
      </section>

      {leadStory && (
        <section class="section blog-zh-curation">
          <div class="section-heading section-heading--with-action">
            <div>
              <p class="eyebrow">Issue Selection / 本期先读</p>
              <h2>如果只读几篇，就从这里开始。</h2>
              <p>精选区优先给出一篇主文和几条延伸阅读，而不是让你直接掉进长列表里。</p>
            </div>
            <a class="text-link" href={getPostPath(leadStory.data.locale, leadStory.data.pathSlug)}>打开主文</a>
          </div>

          <div class="blog-zh-curation__grid">
            <article class="surface curation-lead">
              <div class="curation-lead__meta">
                <span class="pill">{leadStory.data.category}</span>
                <time datetime={leadStory.data.publishedAt.toISOString()}>{formatDate(leadStory.data.publishedAt, locale)}</time>
              </div>

              <div class="curation-lead__body">
                <p class="eyebrow">Lead Article</p>
                <h3>{leadStory.data.title}</h3>
                <p>{leadStory.data.excerpt}</p>
              </div>

              <div class="tag-row tag-row--wrap">
                {leadStory.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>

              <a class="button curation-lead__cta" href={getPostPath(leadStory.data.locale, leadStory.data.pathSlug)}>阅读主文</a>
            </article>

            <div class="curation-briefing">
              {briefingPosts.map((post, index) => (
                <article class="surface briefing-card">
                  <div class="briefing-card__meta">
                    <span class="eyebrow">{String(index + 2).padStart(2, '0')}</span>
                    <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, locale)}</time>
                  </div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.excerpt}</p>
                  <a class="text-link" href={getPostPath(post.data.locale, post.data.pathSlug)}>继续阅读</a>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="catalog-shell catalog-shell--zh section" data-blog-filters>
        <aside class="catalog-sidebar">
          <article class="surface dossier-card">
            <p class="eyebrow">Catalog / Snapshot</p>
            <h2>{catalogTitle}</h2>
            <p>{catalogDescription}</p>

            <div class="metrics-grid">
              {catalogMetrics.map((metric) => (
                <article class="metric-card">
                  <span>{metric.label}</span>
                  <strong>{metric.value}</strong>
                </article>
              ))}
            </div>

            <div class="locale-stack">
              {localeBreakdown.map((item) => (
                <div class="locale-stack__item">
                  <span>{item.label}</span>
                  <strong>{String(item.value).padStart(2, '0')}</strong>
                </div>
              ))}
            </div>

            <div class="note-list">
              {catalogNotes.map((item) => <p>{item}</p>)}
            </div>
          </article>

          <div class="surface filter-panel">
            <label class="filter-panel__search">
              <span>{copy.blog.searchLabel}</span>
              <input type="search" placeholder={copy.blog.searchPlaceholder} data-search-input />
            </label>

            <div class="filter-group">
              <span>{copy.blog.categoryLabel}</span>
              <div class="chip-group">
                <button type="button" class="filter-chip is-active" data-category-filter="all">{copy.blog.allCategories}</button>
                {categories.map((category) => (
                  <button type="button" class="filter-chip" data-category-filter={category}>{category}</button>
                ))}
              </div>
            </div>

            <div class="filter-group">
              <span>{copy.blog.tagLabel}</span>
              <div class="chip-group">
                <button type="button" class="filter-chip is-active" data-tag-filter="all">{copy.blog.allTags}</button>
                {tags.map((tag) => (
                  <button type="button" class="filter-chip" data-tag-filter={tag}>{tag}</button>
                ))}
              </div>
            </div>

            <p class="filter-panel__count" data-results-count>{`${posts.length} ${copy.blog.resultLabel}`}</p>
          </div>
        </aside>

        <div class="catalog-stage">
          <div class="section-heading">
            <p class="eyebrow">Full Archive / 全部归档</p>
            <h2>完整文章列表</h2>
            <p>下面保留完整筛选和跨语言归档能力，方便按主题、标签和时间继续深入阅读。</p>
          </div>

          <div class="posts-grid posts-grid--catalog">
            {posts.map((post) => (
              <div
                data-post-card
                data-search-text={`${post.data.locale} ${post.data.title} ${post.data.excerpt} ${post.data.category} ${post.data.tags.join(' ')}`.toLowerCase()}
                data-category={post.data.category}
                data-tags={post.data.tags.join('|')}
              >
                <PostCard post={post} locale={locale} />
              </div>
            ))}
          </div>

          <div class="surface empty-state" data-empty-state hidden>
            <h2>{copy.blog.emptyTitle}</h2>
            <p>{copy.blog.emptyBody}</p>
          </div>
        </div>
      </section>
    </>
  ) : (
    <>
      <PageIntro eyebrow={copy.blog.eyebrow} title={copy.blog.title} description={copy.blog.description}>
        <div class="page-intro__actions">
          <a class="button button--ghost" href={getLocalizedPath(locale, 'studio')}>{copy.blog.studioAction}</a>
          <a class="text-link" href={getLocalizedPath(locale, 'search')}>Open search</a>
          <a class="text-link" href={SITE.commentsRepositoryUrl} target="_blank" rel="noreferrer">{copy.blog.commentsAction}</a>
        </div>
      </PageIntro>

      <section class="catalog-shell section" data-blog-filters>
        <aside class="catalog-sidebar">
          <article class="surface dossier-card">
            <p class="eyebrow">CATALOG / SNAPSHOT</p>
            <h2>{catalogTitle}</h2>
            <p>{catalogDescription}</p>

            <div class="metrics-grid">
              {catalogMetrics.map((metric) => (
                <article class="metric-card">
                  <span>{metric.label}</span>
                  <strong>{metric.value}</strong>
                </article>
              ))}
            </div>

            <div class="locale-stack">
              {localeBreakdown.map((item) => (
                <div class="locale-stack__item">
                  <span>{item.label}</span>
                  <strong>{String(item.value).padStart(2, '0')}</strong>
                </div>
              ))}
            </div>

            <div class="note-list">
              {catalogNotes.map((item) => <p>{item}</p>)}
            </div>
          </article>

          <div class="surface filter-panel">
            <label class="filter-panel__search">
              <span>{copy.blog.searchLabel}</span>
              <input type="search" placeholder={copy.blog.searchPlaceholder} data-search-input />
            </label>

            <div class="filter-group">
              <span>{copy.blog.categoryLabel}</span>
              <div class="chip-group">
                <button type="button" class="filter-chip is-active" data-category-filter="all">{copy.blog.allCategories}</button>
                {categories.map((category) => (
                  <button type="button" class="filter-chip" data-category-filter={category}>{category}</button>
                ))}
              </div>
            </div>

            <div class="filter-group">
              <span>{copy.blog.tagLabel}</span>
              <div class="chip-group">
                <button type="button" class="filter-chip is-active" data-tag-filter="all">{copy.blog.allTags}</button>
                {tags.map((tag) => (
                  <button type="button" class="filter-chip" data-tag-filter={tag}>{tag}</button>
                ))}
              </div>
            </div>

            <p class="filter-panel__count" data-results-count>{`${posts.length} ${copy.blog.resultLabel}`}</p>
          </div>
        </aside>

        <div class="catalog-stage">
          <div class="section-heading">
            <p class="eyebrow">LATEST / CATALOG</p>
            <h2>Filtered reading list</h2>
            <p>Results update instantly as you change query, category, or tags.</p>
          </div>

          <div class="posts-grid posts-grid--catalog">
            {posts.map((post) => (
              <div
                data-post-card
                data-search-text={`${post.data.locale} ${post.data.title} ${post.data.excerpt} ${post.data.category} ${post.data.tags.join(' ')}`.toLowerCase()}
                data-category={post.data.category}
                data-tags={post.data.tags.join('|')}
              >
                <PostCard post={post} locale={locale} />
              </div>
            ))}
          </div>

          <div class="surface empty-state" data-empty-state hidden>
            <h2>{copy.blog.emptyTitle}</h2>
            <p>{copy.blog.emptyBody}</p>
          </div>
        </div>
      </section>
    </>
  )}

  <script is:inline set:html={filterScript}></script>
</BaseLayout>
