---
import PageIntro from '../../../components/PageIntro.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDate, getAllPosts, getCategories, getTags } from '../../../lib/posts';
import { LOCALES, SITE, getBlogPath, getDictionary, getLanguagePaths, getLocalizedPath, getPostPath, type Locale } from '../../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
    props: { locale }
  }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const posts = await getAllPosts();
const localizedPosts = posts.filter((post) => post.data.locale === locale);
const blogPosts = locale === 'zh' ? localizedPosts : posts;
const categories = getCategories(blogPosts);
const tags = getTags(blogPosts);
const paths = getLanguagePaths('blog');
const resultLabel = copy.blog.resultLabel;
const filterScript = `(() => {
  const root = document.querySelector('[data-blog-filters]');
  if (!root) return;

  const cards = [...root.querySelectorAll('[data-post-card]')];
  const categoryButtons = [...root.querySelectorAll('[data-category-filter]')];
  const tagButtons = [...root.querySelectorAll('[data-tag-filter]')];
  const count = root.querySelector('[data-results-count]');
  const empty = root.querySelector('[data-empty-state]');
  const params = new URLSearchParams(window.location.search);
  const state = {
    category: params.get('category') || 'all',
    tag: params.get('tag') || 'all'
  };

  const syncButtons = (buttons, value, key) => {
    buttons.forEach((button) => {
      const active = button.dataset[key] === value;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  };

  const apply = () => {
    let visible = 0;

    cards.forEach((card) => {
      const matchesCategory = state.category === 'all' || card.dataset.category === state.category;
      const matchesTag = state.tag === 'all' || (card.dataset.tags || '').split('|').includes(state.tag);
      const show = matchesCategory && matchesTag;
      card.hidden = !show;
      if (show) visible += 1;
    });

    if (count) count.textContent = visible + ' ' + ${JSON.stringify(resultLabel)};
    if (empty) empty.hidden = visible !== 0;

    const nextParams = new URLSearchParams();
    if (state.category !== 'all') nextParams.set('category', state.category);
    if (state.tag !== 'all') nextParams.set('tag', state.tag);
    const nextValue = nextParams.toString();
    history.replaceState({}, '', nextValue ? window.location.pathname + '?' + nextValue : window.location.pathname);

    syncButtons(categoryButtons, state.category, 'categoryFilter');
    syncButtons(tagButtons, state.tag, 'tagFilter');
  };

  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      state.category = button.dataset.categoryFilter || 'all';
      apply();
    });
  });

  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      state.tag = button.dataset.tagFilter || 'all';
      apply();
    });
  });

  apply();
})();`;
---

<BaseLayout
  locale={locale}
  currentNav="blog"
  pagePath={getBlogPath(locale)}
  paths={paths}
  title={`${copy.nav.blog} | ${copy.branding.title}`}
  description={copy.blog.description}
>
  {locale === 'zh' ? (
    <>
      <section class="blog-simple-head panel">
        <div class="blog-simple-head__copy">
          <p class="eyebrow">Blog Archive</p>
          <h1>博客</h1>
          <p class="blog-simple-head__description">
            这里只保留两层信息：分类与标签筛选，以及按照发布时间倒序排列的文章列表。
          </p>
        </div>
      </section>

      <section class="section blog-simple-filters" data-blog-filters>
        <div class="surface blog-simple-filter-card">
          <div class="filter-group">
            <span>{copy.blog.categoryLabel}</span>
            <div class="chip-group">
              <button type="button" class="filter-chip is-active" data-category-filter="all">{copy.blog.allCategories}</button>
              {categories.map((category) => (
                <button type="button" class="filter-chip" data-category-filter={category}>{category}</button>
              ))}
            </div>
          </div>

          <div class="filter-group">
            <span>{copy.blog.tagLabel}</span>
            <div class="chip-group">
              <button type="button" class="filter-chip is-active" data-tag-filter="all">{copy.blog.allTags}</button>
              {tags.map((tag) => (
                <button type="button" class="filter-chip" data-tag-filter={tag}>{tag}</button>
              ))}
            </div>
          </div>

          <p class="filter-panel__count" data-results-count>{`${blogPosts.length} ${copy.blog.resultLabel}`}</p>
        </div>

        <div class="section-heading section-heading--with-action">
          <div>
            <p class="eyebrow">Recent Posts</p>
            <h2>最近发布</h2>
            <p>文章按发布时间倒序排列，方便按时间线查看更新。</p>
          </div>
          <a class="text-link" href={getLocalizedPath(locale)}>返回首页</a>
        </div>

        <div class="blog-simple-list">
          {blogPosts.map((post) => (
            <article
              class="surface blog-simple-item"
              data-post-card
              data-category={post.data.category}
              data-tags={post.data.tags.join('|')}
            >
              <div class="blog-simple-item__meta">
                <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, locale)}</time>
                <span class="pill">{post.data.category}</span>
              </div>

              <div class="blog-simple-item__body">
                <h3>{post.data.title}</h3>
                <p>{post.data.excerpt}</p>
              </div>

              <div class="blog-simple-item__footer">
                <div class="tag-row tag-row--wrap">
                  {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
                <a class="text-link" href={getPostPath(post.data.locale, post.data.pathSlug)}>阅读全文</a>
              </div>
            </article>
          ))}
        </div>

        <div class="surface empty-state" data-empty-state hidden>
          <h2>{copy.blog.emptyTitle}</h2>
          <p>{copy.blog.emptyBody}</p>
        </div>
      </section>
    </>
  ) : (
    <>
      <PageIntro eyebrow={copy.blog.eyebrow} title={copy.blog.title} description={copy.blog.description}>
        <div class="page-intro__actions">
          <a class="button button--ghost" href={getLocalizedPath(locale, 'studio')}>{copy.blog.studioAction}</a>
          <a class="text-link" href={getLocalizedPath(locale, 'search')}>Open search</a>
          <a class="text-link" href={SITE.commentsRepositoryUrl} target="_blank" rel="noreferrer">{copy.blog.commentsAction}</a>
        </div>
      </PageIntro>

      <section class="catalog-shell section" data-blog-filters>
        <aside class="catalog-sidebar">
          <article class="surface dossier-card">
            <p class="eyebrow">Catalog / Snapshot</p>
            <h2>Catalog overview</h2>
            <p>A practical listing for browsing by category, tag, and locale.</p>
          </article>
        </aside>

        <div class="catalog-stage">
          <div class="section-heading">
            <p class="eyebrow">LATEST / CATALOG</p>
            <h2>Filtered reading list</h2>
            <p>Results update instantly as you change category or tags.</p>
          </div>

          <div class="blog-simple-list">
            {blogPosts.map((post) => (
              <article class="surface blog-simple-item">
                <div class="blog-simple-item__meta">
                  <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, locale)}</time>
                  <span class="pill">{post.data.category}</span>
                </div>
                <div class="blog-simple-item__body">
                  <h3>{post.data.title}</h3>
                  <p>{post.data.excerpt}</p>
                </div>
                <div class="blog-simple-item__footer">
                  <div class="tag-row tag-row--wrap">
                    {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                  <a class="text-link" href={getPostPath(post.data.locale, post.data.pathSlug)}>Read post</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  <script is:inline set:html={filterScript}></script>
</BaseLayout>
