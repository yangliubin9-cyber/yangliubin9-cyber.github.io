---
import PageIntro from '../../../components/PageIntro.astro';
import PostCard from '../../../components/PostCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDate, getAllPosts, getCategories, getTags } from '../../../lib/posts';
import { LOCALES, SITE, getBlogPath, getDictionary, getLanguagePaths, getLocalizedPath, getPostPath, type Locale } from '../../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
    props: { locale }
  }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const posts = await getAllPosts();
const localizedPosts = posts.filter((post) => post.data.locale === locale);
const catalogPosts = locale === 'zh' ? localizedPosts : posts;
const catalogCategories = getCategories(catalogPosts);
const catalogTags = getTags(catalogPosts);
const paths = getLanguagePaths('blog');
const resultLabel = copy.blog.resultLabel;
const leadStory = localizedPosts[0] ?? posts[0] ?? null;
const briefingPosts = localizedPosts.slice(1, 3);
const metrics = [
  { label: locale === 'zh' ? '当前语言文章' : 'Locale posts', value: String(localizedPosts.length).padStart(2, '0') },
  { label: locale === 'zh' ? '全部归档' : 'All posts', value: String(posts.length).padStart(2, '0') },
  { label: locale === 'zh' ? '主题分类' : 'Categories', value: String(catalogCategories.length).padStart(2, '0') }
];
const filterScript = `(() => {
  const root = document.querySelector('[data-blog-filters]');
  if (!root) return;

  const cards = [...root.querySelectorAll('[data-post-card]')];
  const searchInput = root.querySelector('[data-search-input]');
  const categoryButtons = [...root.querySelectorAll('[data-category-filter]')];
  const tagButtons = [...root.querySelectorAll('[data-tag-filter]')];
  const categorySelect = root.querySelector('[data-category-select]');
  const tagSelect = root.querySelector('[data-tag-select]');
  const count = root.querySelector('[data-results-count]');
  const empty = root.querySelector('[data-empty-state]');
  const params = new URLSearchParams(window.location.search);
  const state = {
    query: params.get('q') || '',
    category: params.get('category') || 'all',
    tag: params.get('tag') || 'all'
  };

  const syncButtons = (buttons, value, key) => {
    buttons.forEach((button) => {
      const active = button.dataset[key] === value;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  };

  const syncSelect = (select, value) => {
    if (!select) return;
    select.value = value;
  };

  const apply = () => {
    const query = state.query.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const matchesQuery = !query || (card.dataset.searchText || '').includes(query);
      const matchesCategory = state.category === 'all' || card.dataset.category === state.category;
      const matchesTag = state.tag === 'all' || (card.dataset.tags || '').split('|').includes(state.tag);
      const show = matchesQuery && matchesCategory && matchesTag;
      card.hidden = !show;
      if (show) visible += 1;
    });

    if (count) count.textContent = visible + ' ' + ${JSON.stringify(resultLabel)};
    if (empty) empty.hidden = visible !== 0;

    const nextParams = new URLSearchParams();
    if (state.query) nextParams.set('q', state.query);
    if (state.category !== 'all') nextParams.set('category', state.category);
    if (state.tag !== 'all') nextParams.set('tag', state.tag);
    const nextValue = nextParams.toString();
    history.replaceState({}, '', nextValue ? window.location.pathname + '?' + nextValue : window.location.pathname);

    syncButtons(categoryButtons, state.category, 'categoryFilter');
    syncButtons(tagButtons, state.tag, 'tagFilter');
    syncSelect(categorySelect, state.category);
    syncSelect(tagSelect, state.tag);
  };

  if (searchInput) {
    searchInput.value = state.query;
    searchInput.addEventListener('input', (event) => {
      state.query = event.target.value;
      apply();
    });
  }

  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      state.category = button.dataset.categoryFilter || 'all';
      apply();
    });
  });

  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      state.tag = button.dataset.tagFilter || 'all';
      apply();
    });
  });

  if (categorySelect) {
    categorySelect.addEventListener('change', (event) => {
      state.category = event.target.value || 'all';
      apply();
    });
  }

  if (tagSelect) {
    tagSelect.addEventListener('change', (event) => {
      state.tag = event.target.value || 'all';
      apply();
    });
  }

  apply();
})();`;
---

<BaseLayout
  locale={locale}
  currentNav="blog"
  pagePath={getBlogPath(locale)}
  paths={paths}
  title={`${copy.nav.blog} | ${copy.branding.title}`}
  description={copy.blog.description}
>
  {locale === 'zh' ? (
    <>
      <section class="enterprise-page-head panel">
        <div class="enterprise-page-head__main">
          <p class="eyebrow">Technical Archive</p>
          <h1>博客归档</h1>
          <p class="enterprise-page-head__description">
            这里收录中文技术文章与长期写作笔记。整体框架参考企业技术博客的组织方式：
            先说明内容范围，再通过检索、分类和标签进入具体文章。
          </p>

          <div class="hero__actions">
            <a class="button" href={getLocalizedPath(locale, 'search')}>搜索文章</a>
            <a class="button button--ghost" href={getLocalizedPath(locale)}>返回首页</a>
          </div>
        </div>

        <aside class="enterprise-page-head__aside surface">
          <p class="eyebrow">Overview</p>

          <div class="enterprise-metrics">
            {metrics.map((metric) => (
              <article class="enterprise-metrics__item">
                <span>{metric.label}</span>
                <strong>{metric.value}</strong>
              </article>
            ))}
          </div>

          <div class="tag-row tag-row--wrap">
            {catalogCategories.slice(0, 5).map((item) => <span class="tag">{item}</span>)}
          </div>

          <p class="enterprise-page-head__note">
            默认聚焦当前语言内容，入口保持简单，适合先筛选再阅读，不再用大量视觉装饰去分散注意力。
          </p>
        </aside>
      </section>

      {leadStory && (
        <section class="surface enterprise-feature-banner">
          <div class="enterprise-feature-banner__main">
            <p class="eyebrow">Latest Highlight</p>
            <h2>{leadStory.data.title}</h2>
            <p>{leadStory.data.excerpt}</p>
          </div>

          <div class="enterprise-feature-banner__side">
            <div class="enterprise-feature-banner__meta">
              <span class="pill">{leadStory.data.category}</span>
              <time datetime={leadStory.data.publishedAt.toISOString()}>{formatDate(leadStory.data.publishedAt, locale)}</time>
            </div>

            <div class="enterprise-feature-banner__list">
              {briefingPosts.map((post) => (
                <a class="enterprise-inline-link" href={getPostPath(post.data.locale, post.data.pathSlug)}>
                  <strong>{post.data.title}</strong>
                  <span>{formatDate(post.data.publishedAt, locale)}</span>
                </a>
              ))}
            </div>

            <a class="button" href={getPostPath(leadStory.data.locale, leadStory.data.pathSlug)}>阅读精选文章</a>
          </div>
        </section>
      )}

      <section class="section" data-blog-filters>
        <div class="surface filter-panel filter-panel--enterprise">
          <label class="filter-panel__field filter-panel__field--search">
            <span>{copy.blog.searchLabel}</span>
            <input type="search" placeholder={copy.blog.searchPlaceholder} data-search-input />
          </label>

          <label class="filter-panel__field">
            <span>{copy.blog.categoryLabel}</span>
            <select data-category-select>
              <option value="all">{copy.blog.allCategories}</option>
              {catalogCategories.map((category) => <option value={category}>{category}</option>)}
            </select>
          </label>

          <label class="filter-panel__field">
            <span>{copy.blog.tagLabel}</span>
            <select data-tag-select>
              <option value="all">{copy.blog.allTags}</option>
              {catalogTags.map((tag) => <option value={tag}>{tag}</option>)}
            </select>
          </label>

          <p class="filter-panel__count" data-results-count>{`${catalogPosts.length} ${copy.blog.resultLabel}`}</p>
        </div>

        <div class="section-heading section-heading--with-action">
          <div>
            <p class="eyebrow">All Posts</p>
            <h2>全部文章</h2>
            <p>筛选结果会即时更新，适合按主题快速定位文章。</p>
          </div>
          <a class="text-link" href={SITE.commentsRepositoryUrl} target="_blank" rel="noreferrer">{copy.blog.commentsAction}</a>
        </div>

        <div class="posts-grid posts-grid--catalog">
          {catalogPosts.map((post) => (
            <div
              data-post-card
              data-search-text={`${post.data.locale} ${post.data.title} ${post.data.excerpt} ${post.data.category} ${post.data.tags.join(' ')}`.toLowerCase()}
              data-category={post.data.category}
              data-tags={post.data.tags.join('|')}
            >
              <PostCard post={post} locale={locale} />
            </div>
          ))}
        </div>

        <div class="surface empty-state" data-empty-state hidden>
          <h2>{copy.blog.emptyTitle}</h2>
          <p>{copy.blog.emptyBody}</p>
        </div>
      </section>
    </>
  ) : (
    <>
      <PageIntro eyebrow={copy.blog.eyebrow} title={copy.blog.title} description={copy.blog.description}>
        <div class="page-intro__actions">
          <a class="button button--ghost" href={getLocalizedPath(locale, 'studio')}>{copy.blog.studioAction}</a>
          <a class="text-link" href={getLocalizedPath(locale, 'search')}>Open search</a>
          <a class="text-link" href={SITE.commentsRepositoryUrl} target="_blank" rel="noreferrer">{copy.blog.commentsAction}</a>
        </div>
      </PageIntro>

      <section class="catalog-shell section" data-blog-filters>
        <aside class="catalog-sidebar">
          <article class="surface dossier-card">
            <p class="eyebrow">Catalog / Snapshot</p>
            <h2>Catalog overview</h2>
            <p>A practical listing for browsing by category, tag, and locale.</p>

            <div class="metrics-grid">
              {metrics.map((metric) => (
                <article class="metric-card">
                  <span>{metric.label}</span>
                  <strong>{metric.value}</strong>
                </article>
              ))}
            </div>
          </article>

          <div class="surface filter-panel">
            <label class="filter-panel__search">
              <span>{copy.blog.searchLabel}</span>
              <input type="search" placeholder={copy.blog.searchPlaceholder} data-search-input />
            </label>

            <div class="filter-group">
              <span>{copy.blog.categoryLabel}</span>
              <div class="chip-group">
                <button type="button" class="filter-chip is-active" data-category-filter="all">{copy.blog.allCategories}</button>
                {catalogCategories.map((category) => (
                  <button type="button" class="filter-chip" data-category-filter={category}>{category}</button>
                ))}
              </div>
            </div>

            <div class="filter-group">
              <span>{copy.blog.tagLabel}</span>
              <div class="chip-group">
                <button type="button" class="filter-chip is-active" data-tag-filter="all">{copy.blog.allTags}</button>
                {catalogTags.map((tag) => (
                  <button type="button" class="filter-chip" data-tag-filter={tag}>{tag}</button>
                ))}
              </div>
            </div>

            <p class="filter-panel__count" data-results-count>{`${catalogPosts.length} ${copy.blog.resultLabel}`}</p>
          </div>
        </aside>

        <div class="catalog-stage">
          <div class="section-heading">
            <p class="eyebrow">LATEST / CATALOG</p>
            <h2>Filtered reading list</h2>
            <p>Results update instantly as you change query, category, or tags.</p>
          </div>

          <div class="posts-grid posts-grid--catalog">
            {catalogPosts.map((post) => (
              <div
                data-post-card
                data-search-text={`${post.data.locale} ${post.data.title} ${post.data.excerpt} ${post.data.category} ${post.data.tags.join(' ')}`.toLowerCase()}
                data-category={post.data.category}
                data-tags={post.data.tags.join('|')}
              >
                <PostCard post={post} locale={locale} />
              </div>
            ))}
          </div>

          <div class="surface empty-state" data-empty-state hidden>
            <h2>{copy.blog.emptyTitle}</h2>
            <p>{copy.blog.emptyBody}</p>
          </div>
        </div>
      </section>
    </>
  )}

  <script is:inline set:html={filterScript}></script>
</BaseLayout>
