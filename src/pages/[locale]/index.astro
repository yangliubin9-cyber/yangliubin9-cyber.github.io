---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts } from '../../lib/posts';
import { LOCALES, PROFILE, getBlogPath, getDictionary, getLanguagePaths, getLocalizedPath, getPostPath, type Locale } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
    props: { locale }
  }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const posts = await getPosts(locale);
const latestPosts = posts.slice(0, 6);
const paths = getLanguagePaths();
---

<BaseLayout
  locale={locale}
  currentNav="home"
  pagePath={getLocalizedPath(locale)}
  paths={paths}
  title={`${copy.branding.title} | ${copy.branding.subtitle}`}
  description={copy.home.heroDescription}
>
  {locale === 'zh' ? (
    <>
      <section class="home-simple-intro panel">
        <div class="home-simple-intro__copy">
          <p class="eyebrow">Personal Blog</p>
          <h1>杨刘彬·言</h1>
          <p class="home-simple-intro__subtitle">{copy.branding.subtitle}</p>
          <p class="home-simple-intro__description">
            这里记录云计算运维、自动化、前端实现和长期写作中的经验。首页只保留最核心的信息：
            一个清晰的个人介绍，以及最近发布的文章。
          </p>
        </div>

        <aside class="home-simple-intro__profile surface">
          <img class="home-simple-intro__avatar" src={PROFILE.avatar} alt={PROFILE.name[locale]} loading="lazy" onerror={`this.onerror=null;this.src='${PROFILE.avatarFallback}'`} />
          <div class="home-simple-intro__profile-copy">
            <h2>{PROFILE.name[locale]}</h2>
            <p>{PROFILE.tagline[locale]}</p>
          </div>
        </aside>
      </section>

      <section class="section">
        <div class="section-heading section-heading--with-action">
          <div>
            <p class="eyebrow">Latest Posts</p>
            <h2>最新文章</h2>
            <p>默认展示最近发布的 3 到 6 篇文章，作为首页唯一的主要阅读入口。</p>
          </div>
          <a class="text-link" href={getBlogPath(locale)}>查看全部文章</a>
        </div>

        <div class="home-simple-posts">
          {latestPosts.map((post) => (
            <article class="surface home-simple-post">
              <div class="home-simple-post__meta">
                <span class="pill">{post.data.category}</span>
                <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, locale)}</time>
              </div>

              <div class="home-simple-post__body">
                <h3>{post.data.title}</h3>
                <p>{post.data.excerpt}</p>
              </div>

              <a class="text-link" href={getPostPath(post.data.locale, post.data.pathSlug)}>阅读全文</a>
            </article>
          ))}
        </div>
      </section>

      <section class="surface home-simple-bottom-card">
        <div class="home-simple-bottom-card__copy">
          <p class="eyebrow">Archive</p>
          <h2>如果你想按主题系统查看内容，直接进入博客归档。</h2>
          <p>归档页会保留分类、标签以及按发布时间排序的完整文章列表。</p>
        </div>

        <div class="home-simple-bottom-card__actions">
          <a class="button" href={getBlogPath(locale)}>打开博客归档</a>
          <a class="button button--ghost" href={getLocalizedPath(locale, 'about')}>查看作者信息</a>
        </div>
      </section>
    </>
  ) : (
    <>
      <section class="hero panel hero--home">
        <div class="hero__copy">
          <p class="eyebrow">{copy.home.eyebrow}</p>
          <h1>{copy.branding.title}</h1>
          <p class="hero__subtitle">{copy.home.heroTitle}</p>
          <p class="hero__headline">{copy.branding.subtitle}</p>
          <p class="page-intro__description">{copy.home.heroDescription}</p>
          <div class="hero__actions">
            <a class="button" href={getBlogPath(locale)}>{copy.home.primary}</a>
            <a class="button button--ghost" href={getLocalizedPath(locale, 'about')}>{copy.home.secondary}</a>
          </div>
        </div>

        <aside class="hero__panel">
          <div class="profile-card surface">
            <img class="profile-card__avatar" src={PROFILE.avatar} alt={PROFILE.name[locale]} loading="lazy" onerror={`this.onerror=null;this.src='${PROFILE.avatarFallback}'`} />
            <div class="profile-card__content">
              <p class="eyebrow">{copy.home.introTitle}</p>
              <h2>{PROFILE.name[locale]}</h2>
              <p>{PROFILE.tagline[locale]}</p>
            </div>
          </div>
        </aside>
      </section>
    </>
  )}
</BaseLayout>
