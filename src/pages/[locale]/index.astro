---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts } from '../../lib/posts';
import { LOCALES, PROFILE, getBlogPath, getDictionary, getLanguagePaths, getLocalizedPath, getPostPath, type Locale } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
    props: { locale }
  }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const posts = await getPosts(locale);
const latestPosts = posts.slice(0, 6);
const paths = getLanguagePaths();
const homeCopy = locale === 'zh'
  ? {
      eyebrow: 'Personal Journal',
      lead: '一个偏向工程表达的个人博客。',
      description:
        '这里保留最重要的三层信息：我是谁，我正在关注什么，以及最近写了什么。版式尽量克制，让阅读和识别都更直接。',
      profileEyebrow: 'Author Profile',
      latestEyebrow: 'Latest Posts',
      latestTitle: '最新文章',
      latestDescription: '首页只展示最近发布的几篇内容，作为最主要的阅读入口。',
      latestAction: '查看全部文章',
      readAction: '阅读全文',
      archiveEyebrow: 'Archive',
      archiveTitle: '按分类、标签和发布时间继续浏览完整博客归档。',
      archiveDescription: '如果你想系统地查看全部内容，博客页会提供更完整的筛选和顺序阅读入口。',
      archivePrimary: '打开博客',
      archiveSecondary: '查看关于'
    }
  : {
      eyebrow: 'Personal Journal',
      lead: 'A restrained technical blog with an editorial frame.',
      description:
        'The homepage stays intentionally concise: who I am, what kind of work I care about, and the latest writing worth opening first.',
      profileEyebrow: 'Author Profile',
      latestEyebrow: 'Latest Posts',
      latestTitle: 'Latest posts',
      latestDescription: 'The front page stays focused on a small set of recent writing instead of too many competing entry points.',
      latestAction: 'View all posts',
      readAction: 'Read post',
      archiveEyebrow: 'Archive',
      archiveTitle: 'Browse the full archive by category, tag, and publish date.',
      archiveDescription: 'The blog index keeps the full list available for filtering and chronological reading.',
      archivePrimary: 'Open blog',
      archiveSecondary: 'About the author'
    };
---

<BaseLayout
  locale={locale}
  currentNav="home"
  pagePath={getLocalizedPath(locale)}
  paths={paths}
  title={`${copy.branding.title} | ${copy.branding.subtitle}`}
  description={copy.home.heroDescription}
>
  <section class="folio-home-hero panel">
    <div class="folio-home-hero__copy">
      <p class="eyebrow">{homeCopy.eyebrow}</p>
      <h1>{copy.branding.title}</h1>
      <p class="folio-home-hero__lead">{homeCopy.lead}</p>
      <p class="folio-home-hero__description">{homeCopy.description}</p>

      <div class="folio-home-hero__actions">
        <a class="button" href={getBlogPath(locale)}>{homeCopy.archivePrimary}</a>
        <a class="button button--ghost" href={getLocalizedPath(locale, 'about')}>{homeCopy.archiveSecondary}</a>
      </div>
    </div>

    <aside class="surface folio-home-profile">
      <img
        class="folio-home-profile__avatar"
        src={PROFILE.avatar}
        alt={PROFILE.name[locale]}
        loading="lazy"
        onerror={`this.onerror=null;this.src='${PROFILE.avatarFallback}'`}
      />

      <div class="folio-home-profile__body">
        <p class="eyebrow">{homeCopy.profileEyebrow}</p>
        <h2>{PROFILE.name[locale]}</h2>
        <p>{PROFILE.tagline[locale]}</p>
      </div>
    </aside>
  </section>

  <section class="section">
    <div class="section-heading section-heading--with-action">
      <div>
        <p class="eyebrow">{homeCopy.latestEyebrow}</p>
        <h2>{homeCopy.latestTitle}</h2>
        <p>{homeCopy.latestDescription}</p>
      </div>

      <a class="text-link" href={getBlogPath(locale)}>{homeCopy.latestAction}</a>
    </div>

    <div class="folio-home-posts">
      {latestPosts.map((post) => (
        <article class="surface folio-home-post">
          <div class="folio-home-post__meta">
            <span class="pill">{post.data.category}</span>
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, locale)}</time>
          </div>

          <div class="folio-home-post__body">
            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
          </div>

          <a class="text-link" href={getPostPath(post.data.locale, post.data.pathSlug)}>{homeCopy.readAction}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="surface folio-home-archive">
    <div class="folio-home-archive__copy">
      <p class="eyebrow">{homeCopy.archiveEyebrow}</p>
      <h2>{homeCopy.archiveTitle}</h2>
      <p>{homeCopy.archiveDescription}</p>
    </div>

    <div class="folio-home-archive__actions">
      <a class="button" href={getBlogPath(locale)}>{homeCopy.archivePrimary}</a>
      <a class="button button--ghost" href={getLocalizedPath(locale, 'about')}>{homeCopy.archiveSecondary}</a>
    </div>
  </section>
</BaseLayout>
