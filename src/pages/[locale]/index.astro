---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts } from '../../lib/posts';
import { LOCALES, PROFILE, getBlogPath, getDictionary, getLanguagePaths, getLocalizedPath, getPostPath, type Locale } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
    props: { locale }
  }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getDictionary(locale);
const posts = await getPosts(locale);
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 3);
const spotlightPosts = featuredPosts.length > 0 ? featuredPosts : posts.slice(0, 3);
const leadPost = spotlightPosts[0] ?? posts[0] ?? null;
const secondaryPosts = spotlightPosts.slice(1, 3);
const categoryCount = new Set(posts.map((post) => post.data.category)).size;
const capabilityTags = copy.about.skills.slice(0, 4);
const paths = getLanguagePaths();
const homeMetrics = [
  { label: '文章总数', value: String(posts.length).padStart(2, '0') },
  { label: '主题分类', value: String(categoryCount).padStart(2, '0') },
  { label: '首页精选', value: String(spotlightPosts.length).padStart(2, '0') }
];
const focusAreas = [
  {
    title: '工程实践',
    description: '围绕云计算、自动化运维和长期可维护的工程方案持续沉淀。'
  },
  {
    title: '前端与体验',
    description: '关注界面表达、组件系统和更适合阅读的技术内容呈现方式。'
  },
  {
    title: '系统化写作',
    description: '把零散经验整理成结构清晰、可复用、适合长期查阅的知识资产。'
  }
];
---

<BaseLayout
  locale={locale}
  currentNav="home"
  pagePath={getLocalizedPath(locale)}
  paths={paths}
  title={`${copy.branding.title} | ${copy.branding.subtitle}`}
  description={copy.home.heroDescription}
>
  {locale === 'zh' ? (
    <>
      <section class="enterprise-home-hero panel">
        <div class="enterprise-home-hero__main">
          <p class="eyebrow">Blogs / Technical Notes</p>
          <h1>面向工程实践的技术博客与系统化笔记</h1>
          <p class="enterprise-home-hero__description">
            这里记录云计算运维、自动化、前端实现和长期写作方法。页面结构尽量保持清晰、稳定和可持续，
            让访客可以像查看企业技术文档一样快速进入内容，而不是先被视觉噪音打断。
          </p>

          <div class="hero__actions">
            <a class="button" href={getBlogPath(locale)}>进入博客归档</a>
            <a class="button button--ghost" href={getLocalizedPath(locale, 'about')}>查看作者信息</a>
          </div>

          <div class="enterprise-metrics">
            {homeMetrics.map((metric) => (
              <article class="enterprise-metrics__item">
                <span>{metric.label}</span>
                <strong>{metric.value}</strong>
              </article>
            ))}
          </div>
        </div>

        <aside class="enterprise-home-hero__aside surface">
          <div class="enterprise-profile">
            <img class="enterprise-profile__avatar" src={PROFILE.avatar} alt={PROFILE.name[locale]} loading="lazy" onerror={`this.onerror=null;this.src='${PROFILE.avatarFallback}'`} />
            <div class="enterprise-profile__body">
              <p class="eyebrow">Author</p>
              <h2>{PROFILE.name[locale]}</h2>
              <p>{PROFILE.tagline[locale]}</p>
            </div>
          </div>

          <div class="tag-row tag-row--wrap">
            {capabilityTags.map((item) => <span class="tag">{item}</span>)}
          </div>

          <div class="enterprise-bullet-list">
            {focusAreas.map((item) => (
              <article class="enterprise-bullet-list__item">
                <strong>{item.title}</strong>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </aside>
      </section>

      {leadPost && (
        <section class="section">
          <div class="section-heading section-heading--with-action">
            <div>
              <p class="eyebrow">Featured / 精选文章</p>
              <h2>先从这几篇开始了解这个博客</h2>
              <p>首页只保留少量入口，先建立内容方向，再进入完整归档继续阅读。</p>
            </div>
            <a class="text-link" href={getBlogPath(locale)}>查看全部文章</a>
          </div>

          <div class="enterprise-feature-grid">
            <article class="surface enterprise-lead-card">
              <div class="enterprise-lead-card__meta">
                <span class="pill">{leadPost.data.category}</span>
                <time datetime={leadPost.data.publishedAt.toISOString()}>{formatDate(leadPost.data.publishedAt, locale)}</time>
              </div>

              <div class="enterprise-lead-card__body">
                <h3>{leadPost.data.title}</h3>
                <p>{leadPost.data.excerpt}</p>
              </div>

              <div class="tag-row tag-row--wrap">
                {leadPost.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>

              <a class="button" href={getPostPath(leadPost.data.locale, leadPost.data.pathSlug)}>阅读全文</a>
            </article>

            <div class="enterprise-compact-list">
              {secondaryPosts.map((post) => (
                <article class="surface enterprise-compact-card">
                  <div class="enterprise-compact-card__meta">
                    <span>{post.data.category}</span>
                    <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, locale)}</time>
                  </div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.excerpt}</p>
                  <a class="text-link" href={getPostPath(post.data.locale, post.data.pathSlug)}>继续阅读</a>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="section">
        <div class="section-heading">
          <p class="eyebrow">Coverage / 写作方向</p>
          <h2>围绕几个稳定主题持续更新</h2>
          <p>整体框架更偏企业技术站：少量重点入口、明确主题域、稳定的归档和检索方式。</p>
        </div>

        <div class="enterprise-topic-grid">
          {focusAreas.map((item) => (
            <article class="surface enterprise-topic-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="surface enterprise-archive-cta">
        <div class="enterprise-archive-cta__copy">
          <p class="eyebrow">Archive / Search</p>
          <h2>需要按主题检索时，直接进入博客归档或搜索页。</h2>
          <p>归档页提供分类、标签和关键词筛选，适合更高效地定位文章。</p>
        </div>

        <div class="enterprise-archive-cta__actions">
          <a class="button" href={getBlogPath(locale)}>打开博客归档</a>
          <a class="button button--ghost" href={getLocalizedPath(locale, 'search')}>搜索内容</a>
        </div>
      </section>
    </>
  ) : (
    <>
      <section class="hero panel hero--home">
        <div class="hero__copy">
          <p class="eyebrow">{copy.home.eyebrow}</p>
          <h1>{copy.branding.title}</h1>
          <p class="hero__subtitle">{copy.home.heroTitle}</p>
          <p class="hero__headline">{copy.branding.subtitle}</p>
          <p class="page-intro__description">{copy.home.heroDescription}</p>
          <div class="hero__actions">
            <a class="button" href={getBlogPath(locale)}>{copy.home.primary}</a>
            <a class="button button--ghost" href={getLocalizedPath(locale, 'about')}>{copy.home.secondary}</a>
          </div>
        </div>

        <aside class="hero__panel">
          <div class="profile-card surface">
            <img class="profile-card__avatar" src={PROFILE.avatar} alt={PROFILE.name[locale]} loading="lazy" onerror={`this.onerror=null;this.src='${PROFILE.avatarFallback}'`} />
            <div class="profile-card__content">
              <p class="eyebrow">{copy.home.introTitle}</p>
              <h2>{PROFILE.name[locale]}</h2>
              <p>{PROFILE.tagline[locale]}</p>
              <div class="tag-row">
                {capabilityTags.map((item) => <span class="tag">{item}</span>)}
              </div>
            </div>
          </div>

          <article class="surface spotlight-card">
            <p class="eyebrow">Current Focus</p>
            <div class="check-list">
              {copy.home.spotlightItems.map((item) => <p>{item}</p>)}
            </div>
          </article>
        </aside>
      </section>

      <section class="section">
        <div class="section-heading section-heading--with-action">
          <div>
            <p class="eyebrow">{copy.home.eyebrow}</p>
            <h2>{copy.home.latestTitle}</h2>
            <p>{copy.home.latestDescription}</p>
          </div>
          <a class="text-link" href={getBlogPath(locale)}>{copy.nav.blog}</a>
        </div>

        <div class="posts-grid">
          {spotlightPosts.map((post) => <PostCard post={post} locale={locale} />)}
        </div>
      </section>
    </>
  )}
</BaseLayout>
