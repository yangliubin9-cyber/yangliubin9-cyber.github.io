---
import { commentsConfig, type Locale } from '../data/site';
import { getUiText } from '../data/ui';
import { utterancesThemeMap } from '../lib/theme';

interface Props {
  locale: Locale;
  threadId: string;
}

const { locale, threadId } = Astro.props;
const commentsUi = getUiText(locale).comments;
const issueTerm = `${commentsConfig.issueTermPrefix}:${threadId}`;
const repoUrl = `https://github.com/${commentsConfig.repo}`;
const issuesUrl = `${repoUrl}/issues`;
---

<section class="section comments-section">
  <div class="comments-intro">
    <div class="comments-copy">
      <span class="eyebrow">{commentsUi.eyebrow}</span>
      <h2>{commentsUi.title}</h2>
      <p class="comments-description">{commentsUi.description}</p>
    </div>
    <div class="comments-actions">
      <a class="button-link primary" href={issuesUrl} target="_blank" rel="noreferrer">
        {commentsUi.primaryActionLabel}
      </a>
      <a class="button-link" href={repoUrl} target="_blank" rel="noreferrer">
        {commentsUi.secondaryActionLabel}
      </a>
    </div>
  </div>

  <div class="comments-guide">
    <article class="comments-guide-card">
      <span class="comments-guide-kicker">{commentsUi.guideTitle}</span>
      <ol class="comments-steps">
        {commentsUi.steps.map((item) => (
          <li>{item}</li>
        ))}
      </ol>
    </article>

    <aside class="comments-meta-card">
      <div class="comments-meta-row">
        <span>{commentsUi.repoLabel}</span>
        <code>{commentsConfig.repo}</code>
      </div>
      <div class="comments-meta-row">
        <span>{commentsUi.threadLabel}</span>
        <code>{issueTerm}</code>
      </div>
      <p class="comments-hint">{commentsUi.hint}</p>
    </aside>
  </div>

  <div class="comments-frame">
    <div class="comments-loading" data-comments-loading>
      <span class="comments-loading-dot" aria-hidden="true"></span>
      <p>{commentsUi.loadingLabel}</p>
    </div>

    <script
      is:inline
      define:vars={{ repo: commentsConfig.repo, issueTerm, errorLabel: commentsUi.errorLabel, utterancesThemeMap }}
    >
      const mount = document.currentScript?.parentElement;

      const resolveTheme = () =>
        document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';

      if (mount && !mount.dataset.utterancesMounted) {
        mount.dataset.utterancesMounted = 'true';
        const loading = mount.querySelector('[data-comments-loading]');
        const script = document.createElement('script');
        script.src = 'https://utteranc.es/client.js';
        script.async = true;
        script.crossOrigin = 'anonymous';
        script.setAttribute('repo', repo);
        script.setAttribute('issue-term', issueTerm);
        script.setAttribute('theme', utterancesThemeMap[resolveTheme()] ?? utterancesThemeMap.light);
        script.addEventListener('load', () => {
          loading?.remove();
        });
        script.addEventListener('error', () => {
          if (loading) {
            loading.innerHTML = `<p>${errorLabel}</p>`;
          }
        });
        mount.appendChild(script);
      }
    </script>
  </div>
</section>
