---
type AboutParagraph = {
  text: string;
};

type ContactItem = {
  label: string;
  value: string;
  href: string;
  note: string;
};

interface AboutContent {
  kicker: string;
  title: string;
  lede?: string;
  aboutEyebrow: string;
  aboutTitle: string;
  aboutParagraphs: AboutParagraph[];
  contactEyebrow: string;
  contactTitle?: string;
  contactSummary: string;
  contactItems: ContactItem[];
}

interface Props {
  content: AboutContent;
}

const { content } = Astro.props;
---

<section class="hero about-page-hero">
  <div class="about-page-intro">
    <span class="kicker">{content.kicker}</span>
    <h1 class="title page-title about-page-title"><span class="gradient-text">{content.title}</span></h1>
    {content.lede ? <p class="lede about-page-lede">{content.lede}</p> : null}
  </div>
</section>

<section class="section about-page-main">
  <article class="about-page-about">
    <span class="eyebrow">{content.aboutEyebrow}</span>
    <h2>{content.aboutTitle}</h2>

    <div class="about-page-paragraphs">
      {content.aboutParagraphs.map((item) => (
        <p>{item.text}</p>
      ))}
    </div>
  </article>

  <aside class="about-page-contact-card">
    <span class="eyebrow">{content.contactEyebrow}</span>
    {content.contactTitle ? <h2>{content.contactTitle}</h2> : null}
    <p class="about-page-contact-summary">{content.contactSummary}</p>

    <div class="about-page-contact-list">
      {content.contactItems.map((item) => (
        <article class="about-page-contact-item">
          <span class="about-page-contact-label">{item.label}</span>
          <a href={item.href}>{item.value}</a>
          <p>{item.note}</p>
        </article>
      ))}
    </div>
  </aside>
</section>

<style>
  .about-page-hero {
    background:
      linear-gradient(180deg, rgba(239, 246, 255, 0.96), rgba(241, 245, 249, 0.92)),
      var(--panel);
  }

  html[data-theme='dark'] .about-page-hero {
    background:
      linear-gradient(180deg, rgba(15, 23, 42, 0.96), rgba(11, 17, 30, 0.94)),
      var(--panel);
  }

  .about-page-intro {
    max-width: 66ch;
  }

  .about-page-title {
    max-width: 16ch;
    font-size: clamp(2rem, 3.4vw, 3.35rem);
    line-height: 1.04;
  }

  .about-page-lede {
    max-width: 60ch;
    margin: 0;
    font-size: 1.04rem;
    line-height: 1.82;
  }

  .about-page-main {
    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(280px, 0.72fr);
    gap: 24px;
    align-items: start;
  }

  .about-page-about h2,
  .about-page-contact-card h2 {
    margin: 10px 0 0;
    max-width: 24ch;
    font-size: clamp(1.55rem, 2.3vw, 2.2rem);
    line-height: 1.12;
    font-family: 'Space Grotesk', 'Manrope', 'PingFang SC', sans-serif;
    letter-spacing: -0.02em;
  }

  .about-page-paragraphs {
    display: grid;
    gap: 16px;
    margin-top: 22px;
  }

  .about-page-paragraphs p {
    margin: 0;
    color: var(--muted);
    line-height: 1.82;
    font-size: 1rem;
  }

  .about-page-contact-card {
    padding: 24px;
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) - 6px);
    box-shadow: var(--shadow);
  }

  html[data-theme='dark'] .about-page-contact-card {
    background: rgba(15, 23, 42, 0.72);
  }

  .about-page-contact-summary {
    margin: 12px 0 0;
    color: var(--muted);
    line-height: 1.74;
  }

  .about-page-contact-list {
    display: grid;
    gap: 16px;
    margin-top: 22px;
  }

  .about-page-contact-item {
    border-top: 1px solid var(--border-strong);
    padding-top: 16px;
  }

  .about-page-contact-label {
    display: inline-flex;
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary-strong);
  }

  .about-page-contact-item a {
    display: inline-flex;
    margin-top: 8px;
    color: var(--text);
    text-decoration: none;
    font-size: 1.05rem;
    line-height: 1.35;
    border-bottom: 1px solid transparent;
  }

  .about-page-contact-item a:hover {
    border-color: currentColor;
  }

  .about-page-contact-item p {
    margin: 10px 0 0;
    color: var(--muted);
    line-height: 1.72;
  }

  @media (max-width: 900px) {
    .about-page-main {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
