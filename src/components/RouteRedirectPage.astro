---
interface Props {
  lang: string;
  title: string;
  redirectTarget: string;
  message: string;
}

const { lang, title, redirectTarget, message } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectTarget}`} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <p>
      {message}
      <a href={redirectTarget}>{redirectTarget}</a>
    </p>
  </body>
</html>
