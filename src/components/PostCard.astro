---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';
import { getDictionary, getPostPath, type Locale } from '../lib/site';

interface Props {
  post: CollectionEntry<'posts'>;
  locale: Locale;
}

const { post, locale } = Astro.props as Props;
const copy = getDictionary(locale);
const href = getPostPath(post.data.locale, post.data.pathSlug);
const localeBadge = copy.localeLabel[post.data.locale];
const readLabel = locale === 'zh' ? '阅读文章' : 'Read post';
---

<article class="post-card" data-accent={post.data.accent}>
  <span class="post-card__index" aria-hidden="true"></span>

  <div class="post-card__topline">
    <div class="post-card__badges">
      <span class="pill">{post.data.category}</span>
      <span class="tag tag--locale">{localeBadge}</span>
    </div>
    <time class="post-card__date" datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, locale)}</time>
  </div>

  <a class="post-card__body" href={href}>
    <h3>{post.data.title}</h3>
    <p>{post.data.excerpt}</p>
  </a>

  <div class="post-card__footer">
    <div class="tag-row">
      {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <a class="text-link" href={href}>{readLabel}</a>
  </div>
</article>
