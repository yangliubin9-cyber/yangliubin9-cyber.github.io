---
import LocaleSwitch from './LocaleSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV_ITEMS, PROFILE, getDictionary, getLocalizedPath, type Locale, type NavKey } from '../lib/site';

interface Props {
  locale: Locale;
  currentNav: NavKey;
  paths: Record<Locale, string>;
}

const { locale, currentNav, paths } = Astro.props as Props;
const copy = getDictionary(locale);
const brandPath = getLocalizedPath(locale);
const searchLabel = locale === 'zh' ? '搜索' : 'Search';
const archiveLabel = locale === 'zh' ? '现场笔记' : 'Field notes';
const identityLabel = locale === 'zh' ? '作者' : 'Author';
const isChineseHome = locale === 'zh' && currentNav === 'home';
const navItems = isChineseHome ? (['blog', 'about'] as NavKey[]) : NAV_ITEMS;
---

<header class:list={['site-header', isChineseHome && 'site-header--home-zh']}>
  <a class="brand" href={brandPath}>
    <span class="brand__mark">YL</span>
    <span class="brand__text">
      <strong>{copy.branding.title}</strong>
      <small>{copy.branding.subtitle}</small>
      <span class="brand__ledger">
        <span>{archiveLabel}</span>
        <span>{isChineseHome ? '中文首页' : copy.nav[currentNav]}</span>
      </span>
    </span>
  </a>

  <nav class="site-nav" aria-label="Primary">
    {navItems.map((item) => (
      <a class:list={['site-nav__item', currentNav === item && 'is-active']} href={getLocalizedPath(locale, item === 'home' ? '' : item)}>
        {copy.nav[item]}
      </a>
    ))}
  </nav>

  <div class="site-header__actions">
    <div class="site-header__identity">
      <span class="site-header__identity-label">{identityLabel}</span>
      <strong>{PROFILE.name[locale]}</strong>
    </div>

    <div class="site-header__links">
      <a class="site-header__utility" href={getLocalizedPath(locale, 'search')}>{searchLabel}</a>
      {!isChineseHome && <a class="site-header__utility" href={getLocalizedPath(locale, 'studio')}>{copy.nav.studio}</a>}
    </div>

    <LocaleSwitch locale={locale} paths={paths} />
    <ThemeToggle locale={locale} />
  </div>
</header>
